# Global security headers for all paths
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; media-src 'self'; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';

# Cache-Control for immutable hashed assets
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Cache-Control for video assets
/games/sandeq-rush/video/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Accept-Ranges: bytes
