---
// Pembuka section: judul kecil + garis 1px di atas. Slot kanan opsional.
// `num` dipertahankan agar halaman lama tetap kompatibel, tapi tidak ditampilkan.
interface Props {
  num?: string;
  title: string;
  class?: string;
}

const { title, class: className = '' } = Astro.props;
---

<div class:list={['mb-8 flex items-baseline justify-between gap-4 border-t border-rule pt-4 sm:mb-12', className]}>
  <h2 class="label">{title}</h2>
  <slot />
</div>
