---
interface Props {
  href?: string;
  title?: string;
  eyebrow?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  badge?: string;
  glow?: 'accent' | 'warm';
  class?: string;
  id?: string;
}

const { href, title, eyebrow, description, image, imageAlt = '', badge, glow = 'accent', class: className = '', id } = Astro.props;
const Tag = href ? 'a' : 'article';
const glowColor = glow === 'warm' ? 'var(--color-warm)' : 'var(--color-accent)';
---

<Tag
  href={href}
  id={id}
  style={`--glow:${glowColor}`}
  class:list={[
    'card group relative flex flex-col overflow-hidden rounded-2xl border border-border bg-surface transition-all duration-300',
    href && 'hover:-translate-y-1 hover:border-[color-mix(in_srgb,var(--glow)_55%,transparent)]',
    className,
  ]}
>
  <!-- Spotlight mengikuti kursor (diatur oleh script di BaseLayout) -->
  <span
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
    style="background: radial-gradient(400px circle at var(--mx, 50%) var(--my, 0%), color-mix(in srgb, var(--glow) 14%, transparent), transparent 60%);"
  ></span>

  {
    image && (
      <div class="relative aspect-[16/10] overflow-hidden bg-surface-2">
        <img src={image} alt={imageAlt} loading="lazy" decoding="async" class="size-full object-cover transition-transform duration-500 group-hover:scale-105" />
      </div>
    )
  }

  <slot name="media" />

  <div class="relative flex flex-1 flex-col gap-3 p-5 sm:p-6">
    {
      (eyebrow || badge) && (
        <div class="flex items-center justify-between gap-2">
          {eyebrow && <p class="font-mono text-xs uppercase tracking-widest text-accent-2">{eyebrow}</p>}
          {badge && <span class="rounded-full border border-border px-2.5 py-0.5 font-mono text-[11px] text-muted">{badge}</span>}
        </div>
      )
    }
    {title && <h3 class="font-heading text-xl font-semibold text-text">{title}</h3>}
    {description && <p class="text-sm leading-relaxed text-muted">{description}</p>}
    <slot />
    {
      href && (
        <span class="mt-auto inline-flex items-center gap-1 pt-2 text-sm font-medium text-text/80 transition-colors group-hover:text-accent-2">
          Selengkapnya <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
        </span>
      )
    }
  </div>
</Tag>
