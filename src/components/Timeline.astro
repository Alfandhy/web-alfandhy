---
// Tahun di kolom kiri, isi di kanan, dipisah garis.
export interface TimelineItem {
  period: string;
  title: string;
  org?: string;
  description?: string;
}

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props;
---

<ol class="border-t border-rule">
  {
    items.map((item) => (
      <li class="r grid grid-cols-1 gap-1 border-b border-rule py-6 sm:grid-cols-12 sm:gap-6">
        <p class="label pt-1 sm:col-span-3">{item.period}</p>
        <div class="sm:col-span-9">
          <h3 class="font-serif text-[1.375rem] leading-[1.3]">{item.title}</h3>
          {item.org && <p class="text-ink-2">{item.org}</p>}
          {item.description && <p class="mt-2 max-w-[65ch] text-ink-2">{item.description}</p>}
        </div>
      </li>
    ))
  }
</ol>
