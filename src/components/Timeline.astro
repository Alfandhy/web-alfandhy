---
export interface TimelineItem {
  title: string;
  org?: string;
  period?: string;
  description?: string;
  tags?: string[];
}

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props;
---

<ol class="relative ml-2 border-l border-border">
  {
    items.map((item) => (
      <li class="reveal relative pb-10 pl-7 last:pb-0">
        <span
          class="absolute -left-[7px] top-1.5 size-3.5 rounded-full border-2 border-bg bg-gradient-to-br from-accent to-accent-2 shadow-[0_0_0_4px] shadow-accent/15"
          aria-hidden="true"
        />
        {item.period && <p class="font-mono text-xs uppercase tracking-widest text-muted">{item.period}</p>}
        <h3 class="mt-1 font-heading text-lg font-semibold text-text">{item.title}</h3>
        {item.org && <p class="text-sm text-accent-2">{item.org}</p>}
        {item.description && <p class="mt-2 text-sm leading-relaxed text-muted">{item.description}</p>}
        {item.tags && item.tags.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-2">
            {item.tags.map((t) => (
              <li class="rounded-full border border-border bg-surface px-2.5 py-0.5 font-mono text-[11px] text-text/80">{t}</li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ol>
