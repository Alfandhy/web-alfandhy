---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2';
  class?: string;
}

const { eyebrow, title, description, align = 'left', as: Heading = 'h2', class: className = '' } = Astro.props;
---

<div class:list={['reveal max-w-2xl', align === 'center' && 'mx-auto text-center', className]}>
  {
    eyebrow && (
      <p class:list={['mb-3 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-accent-2', align === 'center' && 'justify-center']}>
        <span class="h-px w-6 bg-accent-2" aria-hidden="true" />
        {eyebrow}
      </p>
    )
  }
  <Heading class:list={['font-heading font-bold text-text', Heading === 'h1' ? 'text-4xl sm:text-5xl md:text-6xl' : 'text-3xl sm:text-4xl']}>
    <Fragment set:html={title} />
  </Heading>
  {description && <p class="mt-4 text-base leading-relaxed text-muted sm:text-lg">{description}</p>}
</div>
