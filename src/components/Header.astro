---
import { DICT, type Lang } from '../data/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'id' } = Astro.props;
const t = DICT[lang];
const isEn = lang === 'en';
const homeHref = isEn ? '/en/' : '/';

// Tautan ke versi bahasa lain dari halaman yang sama.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const idPath = path.replace(/^\/en(\/|$)/, '/');
const enPath = idPath === '/' ? '/en/' : `/en${idPath}`;

// Tandai menu aktif (abaikan tautan jangkar).
const isActive = (href: string) => !href.includes('#') && path.startsWith(href);
---

<header class="border-b border-rule">
  <div class="wrap flex h-16 items-center justify-between gap-6">
    <a href={homeHref} class="text-[1.125rem] font-semibold tracking-[-0.01em]">Alfandhy</a>

    <div class="flex items-center gap-6">
      <nav aria-label={isEn ? 'Primary' : 'Utama'} class="hidden sm:block">
        <ul class="flex items-center gap-7 text-[0.9375rem]">
          {
            t.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={['transition-colors hover:text-ink', isActive(item.href) ? 'text-ink' : 'text-ink-2']}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <a
        href={isEn ? idPath : enPath}
        hreflang={isEn ? 'id' : 'en'}
        lang={isEn ? 'id' : 'en'}
        class="text-sm text-ink-2 transition-colors hover:text-ink"
        title={isEn ? 'Baca dalam Bahasa Indonesia' : 'Read in English'}
      >
        {isEn ? 'ID' : 'EN'}
      </a>

      <button id="menu-open" type="button" class="text-[0.9375rem] sm:hidden" aria-controls="mobile-menu" aria-expanded="false">
        {t.common.menu}
      </button>
    </div>
  </div>
</header>

<!-- Menu layar penuh (mobile) -->
<div id="mobile-menu" class="fixed inset-0 z-50 hidden flex-col bg-paper sm:hidden" role="dialog" aria-modal="true" aria-label={t.common.menu}>
  <div class="wrap flex h-16 items-center justify-between border-b border-rule">
    <a href={homeHref} class="text-[1.125rem] font-semibold tracking-[-0.01em]">Alfandhy</a>
    <button id="menu-close" type="button" class="text-[0.9375rem]">{t.common.close}</button>
  </div>
  <nav aria-label={t.common.menu} class="wrap flex-1 overflow-y-auto pt-4 pb-10">
    <ul>
      <li class="border-b border-rule">
        <a href={homeHref} class="block py-4 text-[1.75rem] font-medium">{t.common.home}</a>
      </li>
      {
        t.nav.map((item) => (
          <li class="border-b border-rule">
            <a href={item.href} class="block py-4 text-[1.75rem] font-medium">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<script>
  const menu = document.getElementById('mobile-menu')!;
  const openBtn = document.getElementById('menu-open')!;
  const closeBtn = document.getElementById('menu-close')!;

  const setOpen = (open: boolean) => {
    menu.classList.toggle('hidden', !open);
    menu.classList.toggle('flex', open);
    openBtn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    (open ? closeBtn : openBtn).focus();
  };

  openBtn.addEventListener('click', () => setOpen(true));
  closeBtn.addEventListener('click', () => setOpen(false));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.classList.contains('hidden')) setOpen(false);
  });
</script>
