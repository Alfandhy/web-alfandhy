---
// Satu karya per baris: nomor, judul serif, ringkasan, tag, gambar besar.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Tag from './Tag.astro';

interface Props {
  num: string;
  title: string;
  summary: string;
  href: string;
  tags?: string[];
  cover?: ImageMetadata;
  coverAlt?: string;
  placeholder?: 'sea' | 'ink' | 'paper';
  placeholderLabel?: string;
}

const { num, title, summary, href, tags = [], cover, coverAlt = '', placeholder = 'paper', placeholderLabel = '[Gambar karya]' } = Astro.props;

const ph = {
  // Blok "laut + garis layar Sandeq": warna datar dengan batas tegas, bukan gradien dekoratif.
  sea: 'bg-[linear-gradient(180deg,#2B5368_0%,#1E3A4C_62%,#C2410C_62.4%,#C2410C_64%,#1E3A4C_64.4%)] text-paper',
  ink: 'bg-[#2A2721] text-rule',
  paper: 'bg-paper-2 text-ink-2',
}[placeholder];
---

<a href={href} class="work-row group r grid grid-cols-1 gap-5 border-b border-rule py-10 first-of-type:pt-0 md:grid-cols-12 md:gap-6">
  <span class="font-mono text-[0.8125rem] text-ink-2 md:col-span-1 md:pt-2.5">{num}</span>

  <div class="order-3 md:order-none md:col-span-4">
    <h3 class="mb-3.5 font-serif text-[clamp(1.75rem,3vw,2.75rem)] leading-[1.05] font-normal tracking-[-0.015em] transition-colors group-hover:text-accent">
      {title}
    </h3>
    <p class="mb-4 max-w-[34ch] text-ink-2">{summary}</p>
    {tags.length > 0 && <div class="flex flex-wrap gap-2">{tags.map((t) => <Tag>{t}</Tag>)}</div>}
  </div>

  <div class="order-2 aspect-[16/10] overflow-hidden border border-rule md:order-none md:col-span-7">
    {
      cover ? (
        <Image
          src={cover}
          alt={coverAlt || title}
          widths={[480, 800, 1200]}
          sizes="(min-width: 768px) 58vw, 100vw"
          class="size-full object-cover transition-transform duration-[600ms] ease-[cubic-bezier(.2,.7,.2,1)] group-hover:scale-[1.02]"
        />
      ) : (
        <div class:list={['flex size-full items-end p-4 transition-transform duration-[600ms] ease-[cubic-bezier(.2,.7,.2,1)] group-hover:scale-[1.02]', ph]}>
          <span class="label !text-current opacity-75">{placeholderLabel}</span>
        </div>
      )
    }
  </div>
</a>
