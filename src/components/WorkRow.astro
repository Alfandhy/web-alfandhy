---
// Satu karya per baris: gambar besar, judul, ringkasan, tag.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Tag from './Tag.astro';

interface Props {
  title: string;
  summary: string;
  href: string;
  tags?: string[];
  cover?: ImageMetadata;
  coverAlt?: string;
}

const { title, summary, href, tags = [], cover, coverAlt = '' } = Astro.props;
---

<a href={href} class="group r grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-8">
  {
    cover && (
      <div class="aspect-[16/10] overflow-hidden rounded-sm border border-rule md:col-span-8">
        <Image
          src={cover}
          alt={coverAlt || title}
          widths={[480, 800, 1200]}
          sizes="(min-width: 768px) 66vw, 100vw"
          class="size-full object-cover transition-transform duration-[600ms] ease-[cubic-bezier(.2,.7,.2,1)] group-hover:scale-[1.02]"
        />
      </div>
    )
  }

  <div class="md:col-span-4 md:self-end">
    <h3 class="mb-3 text-[clamp(1.75rem,3vw,2.5rem)] leading-[1.05] font-semibold tracking-[-0.02em] transition-colors group-hover:text-accent">
      {title}
    </h3>
    <p class="mb-4 max-w-[36ch] text-ink-2">{summary}</p>
    {tags.length > 0 && <div class="flex flex-wrap gap-2">{tags.map((t) => <Tag>{t}</Tag>)}</div>}
  </div>
</a>
