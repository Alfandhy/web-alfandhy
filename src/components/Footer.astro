---
import { CONTACT, SOCIALS } from '../data/site';
import { DICT, type Lang } from '../data/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'id' } = Astro.props;
const t = DICT[lang].contact;
const year = new Date().getFullYear();
const privacyHref = lang === 'en' ? '/en/privacy/' : '/privacy/';
---

<footer id="kontak" class="mt-24 border-t border-rule bg-paper-2 pt-16 pb-10 sm:mt-32 sm:pt-24">
  <div class="wrap">
    <p class="label mb-5">{t.title}</p>
    <h2 class="h2 max-w-[18ch]">{t.heading}</h2>
    <p class="mt-5 max-w-[56ch] text-ink-2">{t.desc}</p>

    <div class="mt-9 flex flex-wrap items-center gap-x-5 gap-y-3">
      <a
        href={`mailto:${CONTACT.email}`}
        id="footer-email"
        class="link text-[clamp(1.375rem,3vw,2rem)] font-medium tracking-[-0.01em]"
      >
        {CONTACT.email}
      </a>
      <button
        id="copy-email-btn"
        type="button"
        data-copied={t.copied}
        class="rounded-sm border border-rule px-3 py-1.5 text-sm text-ink-2 transition-colors hover:border-ink-2 hover:text-ink"
      >
        {t.copy}
      </button>
    </div>

    <div class="mt-16 flex flex-col gap-6 border-t border-rule pt-6 text-sm text-ink-2 sm:mt-20 md:flex-row md:items-center md:justify-between">
      <p>© {year} Alfandhy · Polewali Mandar, {t.region}</p>
      <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
        {
          SOCIALS.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="me noopener" class="transition-colors hover:text-ink">
                {s.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={privacyHref} class="transition-colors hover:text-ink">{t.privacy}</a>
        </li>
      </ul>
    </div>
  </div>
</footer>

<script>
  const btn = document.getElementById('copy-email-btn');
  const email = document.getElementById('footer-email');
  if (btn && email) {
    const original = btn.textContent;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email.textContent?.trim() ?? '');
        btn.textContent = btn.dataset.copied ?? original;
        setTimeout(() => (btn.textContent = original), 2000);
      } catch {
        // Clipboard tidak tersedia; tautan mailto tetap bisa dipakai.
      }
    });
  }
</script>
