---
import { NAV, SITE, SOCIALS } from '../data/site';

const year = new Date().getFullYear();
// Placeholder seperti "[LINK INSTAGRAM]" belum diisi → arahkan ke "#"
const safeHref = (href: string) => (href.startsWith('[') ? '#' : href);
---

<footer class="relative mt-24 border-t border-border bg-surface/40">
  <div class="container-site grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <a href="/" class="font-heading text-xl font-bold">alfandhy<span class="text-accent-2">.</span></a>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted">{SITE.tagline}</p>
    </div>

    <nav aria-label="Navigasi footer">
      <p class="font-mono text-xs uppercase tracking-widest text-muted">Jelajahi</p>
      <ul class="mt-4 grid grid-cols-2 gap-2 text-sm">
        {NAV.map((item) => (
          <li><a href={item.href} class="text-text/80 transition-colors hover:text-accent-2">{item.label}</a></li>
        ))}
        <li><a href="/game/sandeqrush/privacy" class="text-text/80 transition-colors hover:text-accent-2">Privacy</a></li>
      </ul>
    </nav>

    <div>
      <p class="font-mono text-xs uppercase tracking-widest text-muted">Sosial</p>
      <ul class="mt-4 flex flex-col gap-2 text-sm">
        {SOCIALS.map((s) => (
          <li>
            <a href={safeHref(s.href)} target="_blank" rel="noopener noreferrer" class="text-text/80 transition-colors hover:text-accent-2">
              {s.label} <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-border">
    <div class="container-site flex flex-col gap-2 py-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.fullName}</p>
      <p>Made with AI &amp; <span aria-label="cinta">❤️</span> in Polewali Mandar</p>
    </div>
  </div>
</footer>
