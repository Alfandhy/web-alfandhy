---
interface Props {
  variant?: 'default' | 'accent' | 'warm';
  class?: string;
}

const { variant = 'default', class: className = '' } = Astro.props;

const variants = {
  default: 'border-border bg-surface text-text/85',
  accent: 'border-accent/40 bg-accent/10 text-accent',
  warm: 'border-warm/40 bg-warm/10 text-warm',
};
---

<span class:list={['inline-flex items-center gap-1.5 rounded-full border px-3 py-1 font-mono text-xs', variants[variant], className]}>
  <slot />
</span>
