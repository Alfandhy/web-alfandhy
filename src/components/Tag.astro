---
// Teks mono kecil dengan border 1px, tanpa warna isi.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['inline-block border border-rule px-2 py-[3px] font-mono text-xs tracking-[0.04em] text-ink-2 uppercase', className]}>
  <slot />
</span>
