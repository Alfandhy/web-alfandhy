---
// Karya pilihan sebagai slider: satu karya per slide (gambar besar kiri, teks kanan).
// Geser dengan swipe/scroll (CSS scroll-snap), tombol panah, atau titik navigasi.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Tag from './Tag.astro';

interface Slide {
  title: string;
  summary: string;
  href: string;
  external?: boolean;
  tags?: string[];
  cover?: ImageMetadata;
  coverAlt?: string;
  linkLabel: string;
}

interface Props {
  slides: Slide[];
  lang: 'id' | 'en';
}

const { slides, lang } = Astro.props;
const L =
  lang === 'en'
    ? { prev: 'Previous work', next: 'Next work', go: 'Show work', region: 'Selected work' }
    : { prev: 'Karya sebelumnya', next: 'Karya berikutnya', go: 'Tampilkan karya', region: 'Karya pilihan' };
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="r" data-carousel role="region" aria-roledescription="carousel" aria-label={L.region}>
  <ul
    data-track
    class="flex snap-x snap-mandatory overflow-x-auto overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
  >
    {
      slides.map((s, i) => (
        <li
          class="w-full shrink-0 snap-start"
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} / ${slides.length}`}
          data-slide
        >
          <a
            href={s.href}
            {...(s.external ? { target: '_blank', rel: 'noopener' } : {})}
            class="group grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-8"
          >
            {s.cover && (
              <div class="aspect-[16/10] overflow-hidden rounded-sm border border-rule md:col-span-8">
                <Image
                  src={s.cover}
                  alt={s.coverAlt || s.title}
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 768px) 66vw, 100vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  class="size-full object-cover object-top transition-transform duration-[600ms] ease-[cubic-bezier(.2,.7,.2,1)] group-hover:scale-[1.02]"
                />
              </div>
            )}
            <div class="md:col-span-4 md:self-end">
              <p class="label mb-3">
                {pad(i + 1)} / {pad(slides.length)}
              </p>
              <h3 class="mb-3 text-[clamp(1.75rem,3vw,2.5rem)] leading-[1.05] font-semibold tracking-[-0.02em] transition-colors group-hover:text-accent">
                {s.title}
              </h3>
              <p class="mb-4 max-w-[36ch] text-ink-2">{s.summary}</p>
              {s.tags && s.tags.length > 0 && (
                <div class="mb-5 flex flex-wrap gap-2">
                  {s.tags.map((t) => (
                    <Tag>{t}</Tag>
                  ))}
                </div>
              )}
              <span class="text-sm text-ink-2 transition-colors group-hover:text-accent">
                {s.linkLabel} {s.external ? '↗' : '→'}
              </span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>

  {
    slides.length > 1 && (
      <div class="mt-8 flex items-center justify-between gap-4">
        <div class="flex gap-2" data-dots>
          {slides.map((s, i) => (
            <button
              type="button"
              data-dot={i}
              aria-label={`${L.go} ${i + 1}: ${s.title}`}
              aria-current={i === 0 ? 'true' : 'false'}
              class="h-1.5 w-6 rounded-full bg-rule transition-all aria-[current=true]:w-10 aria-[current=true]:bg-accent"
            />
          ))}
        </div>
        <div class="flex gap-2">
          <button
            type="button"
            data-prev
            aria-label={L.prev}
            class="flex size-11 items-center justify-center rounded-full border border-rule text-ink-2 transition-colors hover:border-accent hover:text-accent disabled:pointer-events-none disabled:opacity-35"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-5" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
          </button>
          <button
            type="button"
            data-next
            aria-label={L.next}
            class="flex size-11 items-center justify-center rounded-full border border-rule text-ink-2 transition-colors hover:border-accent hover:text-accent disabled:pointer-events-none disabled:opacity-35"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-5" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
          </button>
        </div>
      </div>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    if (slides.length < 2) return;

    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i: number) => {
      const n = Math.max(0, Math.min(slides.length - 1, i));
      const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
      track.scrollTo({ left: n * track.clientWidth, behavior: smooth ? 'smooth' : 'auto' });
    };
    const sync = () => {
      const i = current();
      dots.forEach((d, j) => d.setAttribute('aria-current', String(j === i)));
      slides.forEach((s, j) => s.toggleAttribute('inert', j !== i));
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i === slides.length - 1;
    };

    prev?.addEventListener('click', () => go(current() - 1));
    next?.addEventListener('click', () => go(current() + 1));
    dots.forEach((d, j) => d.addEventListener('click', () => go(j)));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(current() - 1);
      if (e.key === 'ArrowRight') go(current() + 1);
    });

    let raf = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(sync);
    });
    sync();
  });
</script>
