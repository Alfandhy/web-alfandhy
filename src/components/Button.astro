---
// Hanya untuk aksi utama: kotak, radius 2px, latar --ink.
interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'solid' | 'outline';
  id?: string;
  external?: boolean;
  class?: string;
}

const { href, type = 'button', variant = 'solid', id, external = false, class: className = '' } = Astro.props;

const classes = [
  'inline-flex h-12 items-center justify-center gap-2 rounded-sm px-6 text-[0.9375rem] font-medium transition-colors',
  variant === 'solid' ? 'bg-ink text-paper hover:bg-accent' : 'border border-ink text-ink hover:border-accent hover:text-accent',
  className,
].join(' ');
const ext = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{
  href ? (
    <a href={href} id={id} class={classes} {...ext}>
      <slot />
    </a>
  ) : (
    <button type={type} id={id} class={classes}>
      <slot />
    </button>
  )
}
