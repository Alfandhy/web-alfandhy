---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import { DICT } from '../data/i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  lang?: 'id' | 'en';
  /** Tanpa header & footer — untuk halaman tautan (mis. /shop). */
  bare?: boolean;
  alternates?: boolean;
}

const { lang = 'id', bare = false, ...props } = Astro.props;
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="google-site-verification" content="newRCdCIu4Xnfpz2Fr80bQlN5FwX-Tjzbg8xzuMPA6s" />
    <script>
      document.documentElement.classList.remove('no-js');
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400..700;1,400..700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <SEO lang={lang} {...props} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:bg-ink focus:px-4 focus:py-2 focus:text-paper">
      {DICT[lang].common.skipToContent}
    </a>
    {!bare && <Header lang={lang} />}
    <main id="main" class="flex-1">
      <slot />
    </main>
    {!bare && <Footer lang={lang} />}

    <script>
      // Muncul perlahan saat scroll.
      const els = document.querySelectorAll('.r');
      if (!('IntersectionObserver' in window)) {
        els.forEach((e) => e.classList.add('in'));
      } else {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }),
          { threshold: 0.12 },
        );
        els.forEach((e) => io.observe(e));
      }
    </script>
  </body>
</html>
