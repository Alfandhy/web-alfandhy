---
// Beranda — PLAN 4.1, acuan visual: docs/prototype-beranda.html
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import WorkRow from '../components/WorkRow.astro';
import Link from '../components/Link.astro';
import HeroAnimation from '../components/HeroAnimation.astro';
import { SITE, SOCIALS } from '../data/site';
import imgAlfandhy from '../assets/images/alfandhy.png';

const featured = (await getCollection('work', ({ data }) => data.featured)).sort((a, b) => a.data.order - b.data.order).slice(0, 1);

const approach = ['Desain & microstock', 'Pendidikan', 'Game', 'Prompt engineering'];

const now = [
  { label: 'Membangun', text: 'Sandeq Rush, persiapan rilis di Google Play.' },
  { label: 'Mengajar', text: 'DKV, Desain Brief, Mikroprosesor, dan Informatika.' },
  { label: 'Belajar', text: 'Pipeline aset game dan motion dengan AI.' },
];
const nowDate = new Intl.DateTimeFormat('id-ID', { month: 'short', year: 'numeric' }).format(new Date());

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Alfandhy',
  honorificSuffix: 'S.T.',
  url: SITE.url,
  jobTitle: 'AI Enthusiast, Educator, Game Developer',
  address: { '@type': 'PostalAddress', addressLocality: 'Polewali Mandar', addressRegion: 'Sulawesi Barat', addressCountry: 'ID' },
  knowsAbout: ['Artificial Intelligence', 'Prompt Engineering', 'Desain Komunikasi Visual', 'Game Development'],
  sameAs: SOCIALS.map((s) => s.href).filter((h) => !h.startsWith('[')),
};
---

<BaseLayout jsonLd={personLd}>
  <!-- HERO -->
  <section class="pt-12 pb-[88px] sm:pt-[72px] sm:pb-[120px]">
    <div class="wrap">
      <p class="label r mb-10">AI Enthusiast — Polewali Mandar, Sulawesi Barat</p>
      <div class="grid grid-cols-1 items-end gap-8 lg:grid-cols-12">
        <div class="r flex flex-col justify-between gap-8 lg:col-span-8">
          <HeroAnimation class="w-full" />
          <h1 class="display">Saya memakai AI untuk <em>mendesain,</em> mengajar, dan membangun game.</h1>
        </div>

        <div class="r grid grid-cols-1 items-end gap-5 sm:grid-cols-[1fr_1.2fr] lg:col-span-4 lg:block">
          <div class="portrait relative flex aspect-[4/5] items-end overflow-hidden border border-rule bg-paper-2">
            <Image src={imgAlfandhy} alt="Alfandhy, S.T." class="absolute inset-0 h-full w-full object-cover saturate-[.85]" />
          </div>
          <div>
            <p class="text-base text-ink-2 lg:mt-5">
              Seorang AI Enthusiast yang memadukan teknologi ke dalam dunia desain dan pendidikan, serta saat ini sedang fokus mengembangkan game edukatif.
            </p>
            <Link href="/#karya" id="hero-work-link" class="mt-3.5 inline-block text-base text-ink">Lihat karya →</Link>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 01 — KARYA TERPILIH -->
  <section id="karya" class="pb-[88px] sm:pb-[140px]">
    <div class="wrap">
      <SectionLabel num="01" title="Karya Terpilih">
        <Link href="/game/sandeq-rush" class="label">Halaman game →</Link>
      </SectionLabel>
      <div>
        {
          featured.map((w, i) => (
            <WorkRow
              num={String(i + 1).padStart(2, '0')}
              title={w.data.title}
              summary={w.data.summary}
              href={w.data.href ?? `/work/${w.id}`}
              tags={w.data.tags}
              cover={w.data.cover}
              coverAlt={w.data.coverAlt}
              placeholder={w.data.placeholder}
              placeholderLabel={w.data.placeholderLabel}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- 02 — CARA SAYA BEKERJA DENGAN AI -->
  <section id="pendekatan" class="pb-[88px] sm:pb-[140px]">
    <div class="wrap">
      <SectionLabel num="02" title="Cara saya bekerja dengan AI" />
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-6">
        <ul class="r lg:col-span-4">
          {
            approach.map((item, i) => (
              <li class="flex items-baseline justify-between border-b border-rule py-3.5 font-serif text-[1.375rem]">
                {item}
                <span class="font-mono text-xs text-ink-2">{String(i + 1).padStart(2, '0')}</span>
              </li>
            ))
          }
        </ul>
        <div class="r space-y-[1em] font-serif text-[clamp(1.375rem,2.2vw,1.875rem)] leading-[1.35] font-light tracking-[-0.005em] lg:col-span-6 lg:col-start-6">
          <p>
            Bagi saya AI bukan pengganti proses kreatif, melainkan <em class="text-accent">alat kerja</em>, seperti pensil dan grid bagi desainer.
          </p>
          <p>
            Saya memakainya untuk mempercepat eksplorasi, lalu memilih, menyunting, dan menyelesaikan karya dengan tangan sendiri. Hal yang sama saya
            ajarkan kepada siswa di kelas.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 — SEKARANG -->
  <section id="sekarang" class="pb-[88px] sm:pb-[140px]">
    <div class="wrap">
      <SectionLabel num="03" title="Sekarang">
        <span class="label">{nowDate}</span>
      </SectionLabel>
      <dl class="r grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-6">
        {
          now.map((n) => (
            <div>
              <dt class="label mb-2">{n.label}</dt>
              <dd class="max-w-[30ch]">{n.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  /* Arsir tipis sebagai penanda tempat foto (hilang setelah foto asli dipasang) */
  .portrait::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(135deg, transparent 0 14px, rgb(22 20 15 / 0.04) 14px 15px);
  }
</style>
