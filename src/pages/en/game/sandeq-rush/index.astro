---
// Sandeq Rush Game Showcase Page (English Version)
// Fully localized with authentic press kit assets, video, and screenshots
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SectionLabel from '../../../../components/SectionLabel.astro';
import Link from '../../../../components/Link.astro';

const gameTitle = 'Sandeq Rush';
const releaseYear = '2026';
const version = 'v0.3.1';
const engine = 'Godot Engine 4.6.3';
const platform = 'Android 16 (API Level 36) · Google Play';
const genre = 'Arcade Sailing Racing · Cultural Maritime Edu';

// --- Release Status & Copyright Configuration ---
// Switch isReleased to true and provide playStoreUrl once live on the Google Play Store
const isReleased = false;
const playStoreUrl: string | null = null; // e.g. 'https://play.google.com/store/apps/details?id=id.sandeqrush.game'

// Switch showDjkiCertificate to true once official registration certificate numbers are issued
const showDjkiCertificate = false;
const djkiData = {
  nomorPencatatan: '[NOMOR PENCATATAN DJKI]',
  tanggalSertifikat: '[TANGGAL SERTIFIKAT DJKI]',
  pemegangHakCipta: 'Alfandhy, S.T.',
  jenisCiptaan: 'Video Game',
};

const stages = [
  {
    num: '01',
    name: 'Polewali Bay',
    distance: '900 meters',
    wind: 'Left crosswind (13 knots)',
    desc: 'Warm-up stage in tranquil bay waters. Master dual-touch sliders for sail trim and outrigger crew ballast balancing.',
    accent: 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400',
  },
  {
    num: '02',
    name: 'Majene Coastal Waters',
    distance: '1,100 meters',
    wind: 'Wind reversal halfway through the course',
    desc: 'Sprint against 3 traditional rival boats (Pambusuang, Tinambung, Majene) reaching speeds up to 30+ knots in coastal seas.',
    accent: 'bg-sky-500/10 border-sky-500/30 text-sky-400',
  },
  {
    num: '03',
    name: 'Cape Rangas',
    distance: '1,000 meters',
    wind: 'Headwind (Wind coming straight from the front)',
    desc: 'Tactical navigation trial. Execute rapid zig-zag tacking maneuvers to slice into incoming headwinds.',
    accent: 'bg-amber-500/10 border-amber-500/30 text-amber-400',
  },
  {
    num: '04',
    name: 'Makassar Strait',
    distance: '1,400 meters',
    wind: 'Open ocean swells & shifting gale gusts',
    desc: 'Open water swells and dynamic wind gusts. Intense crew balancing required on outriggers to prevent capsizing.',
    accent: 'bg-purple-500/10 border-purple-500/30 text-purple-400',
  },
  {
    num: '05',
    name: 'Losari Beach (Makassar)',
    distance: '1,300 meters',
    wind: 'Heavy finishing gusts',
    desc: 'Grand finale course inspired by the finish line of the annual West Sulawesi Sandeq Race toward iconic Makassar.',
    accent: 'bg-accent/15 border-accent/40 text-accent',
  },
];

const screenshots = [
  {
    src: '/games/sandeq-rush/screenshots/screenshot-menu-utama.png',
    title: 'Main Menu & Sailor Profile',
    caption: 'Hero interface featuring 3D logo, Sandeq Race Career, interactive tutorial, and local leaderboards.',
  },
  {
    src: '/games/sandeq-rush/screenshots/screenshot-peta-etape.png',
    title: '5 Career Stages & Star Tracker',
    caption: 'Championship map tracing Polewali Bay to Losari Beach with stage best times and star progression.',
  },
  {
    src: '/games/sandeq-rush/screenshots/screenshot-tutorial.png',
    title: 'Guided Interactive Tutorial',
    caption: 'Beginner-friendly step-by-step guidance teaching sail tension and outrigger ballast controls.',
  },
  {
    src: '/games/sandeq-rush/screenshots/screenshot-balapan-majene.png',
    title: 'Intense 4-Boat Fleet Racing in Majene',
    caption: 'High-octane competition with dynamic wave spray particles and real-time boat telemetry.',
  },
  {
    src: '/games/sandeq-rush/screenshots/screenshot-kecepatan-penuh.png',
    title: 'Velocity Action at 30+ Knots',
    caption: 'Harnessing crosswind gusts with optimal sail trim to secure the lead.',
  },
  {
    src: '/games/sandeq-rush/screenshots/screenshot-hasil-lomba.png',
    title: 'Victory Podium & Maritime Fact Cards',
    caption: 'Race results celebration combined with educational cards highlighting Mandar maritime heritage.',
  },
  {
    src: '/games/sandeq-rush/screenshots/screenshot-ensiklopedia.png',
    title: 'Sandeq Maritime Encyclopedia',
    caption: 'Integrated cultural knowledge base detailing Sandeq naval anatomy, tacking science, and traditions.',
  },
  {
    src: '/games/sandeq-rush/screenshots/screenshot-menu-jeda.png',
    title: 'Pause Overlay & Android Safe Area',
    caption: 'Adaptive layout respecting camera notches with automatic race pausing during interruptions.',
  },
];

const boats = [
  {
    src: '/games/sandeq-rush/game-assets/perahu/boat_player.png',
    name: 'Player Boat (Red & White)',
    role: 'Primary Player Craft',
    desc: 'Iconic triangular sail pattern with responsive dual-bamboo outriggers.',
  },
  {
    src: '/games/sandeq-rush/game-assets/perahu/rival_blue.png',
    name: 'Passandeq Pambusuang (Blue)',
    role: 'Rival Fleet 01',
    desc: 'Renowned for stability when cutting across the heavy swells of Majene.',
  },
  {
    src: '/games/sandeq-rush/game-assets/perahu/rival_yellow.png',
    name: 'Layar Tinambung (Yellow-Black)',
    role: 'Rival Fleet 02',
    desc: 'Engineered for rapid acceleration under direct tailwinds.',
  },
  {
    src: '/games/sandeq-rush/game-assets/perahu/rival_green.png',
    name: 'Angin Majene (Green)',
    role: 'Rival Fleet 03',
    desc: 'Specialized in sharp zig-zag tacking against challenging headwinds.',
  },
];

const encyclopedias = [
  {
    term: 'Sandeq',
    category: 'Vessel',
    text: 'Originating from the Mandar word for "sharp", referring to the ultra-slender hull designed to slice water with minimal hydrodynamic drag.',
  },
  {
    term: 'Sombal (Triangular Sail)',
    category: 'Rigging',
    text: 'Forward-raked lateen triangular sail capturing aerodynamic lift similar to aircraft wings, generating powerful forward momentum.',
  },
  {
    term: 'Palatto & Barat (Outriggers)',
    category: 'Stability',
    text: 'Twin bamboo outriggers mounted on both flanks, providing equilibrium when heeled by strong sea gusts.',
  },
  {
    term: 'Passandeq & Pakkadacai',
    category: 'Crew',
    text: 'Skilled Mandar mariners who hike out onto elevated outriggers, using body weight as dynamic ballast to counterbalance wind forces.',
  },
  {
    term: 'Tacking Maneuver',
    category: 'Navigation',
    text: 'Zig-zag sailing technique required when heading upwind, requiring coordinated sail trim and crew shifting.',
  },
  {
    term: 'Sandeq Race Heritage',
    category: 'Cultural Tradition',
    text: 'Annual traditional outrigger sailing challenge traversing West Sulawesi coastal waters across the Makassar Strait.',
  },
];
const videoGameLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: gameTitle,
  description:
    'An arcade sailing mobile game for Android featuring traditional Mandar outrigger boats, dynamic wind simulation, 5 championship stages, and an educational maritime encyclopedia.',
  genre: ['Arcade Racing', 'Educational', 'Maritime Simulation'],
  gamePlatform: ['Android'],
  operatingSystem: 'Android 10 and above',
  applicationCategory: 'Game',
  author: {
    '@type': 'Person',
    name: 'Alfandhy',
    url: 'https://alfandhy.my.id',
  },
  inLanguage: ['en', 'id'],
  playMode: 'SinglePlayer',
};
---

<BaseLayout
  jsonLd={videoGameLd}
  lang="en"
  title={`${gameTitle} — Traditional Mandar Sailing Racing Game`}
  description="Sandeq Rush is an arcade sailing mobile game for Android featuring traditional Mandar outrigger boats. Experience authentic wind physics up to 30+ knots in-game, 5 career stages (5,700 m total), and a maritime encyclopedia."
>
  <main class="relative bg-paper text-ink overflow-hidden">

    <!-- HERO SECTION -->
    <section class="relative min-h-[85vh] lg:min-h-[92vh] flex items-center justify-center overflow-hidden border-b border-rule bg-[#07131b]">
      
      <!-- Video Loop Background -->
      <div class="absolute inset-0 z-0 overflow-hidden">
        <video
          autoplay
          loop
          muted
          playsinline
          poster="/games/sandeq-rush/video/sandeq-rush-hero-poster.jpg"
          class="h-full w-full object-cover opacity-20 filter brightness-[0.4] contrast-[1.25] saturate-[0.8]"
        >
          <source src="/games/sandeq-rush/video/sandeq-rush-hero-loop.mp4" type="video/mp4" />
        </video>
        <!-- Dark Deep-Sea Gradient Overlays -->
        <div class="absolute inset-0 bg-[#07131b]/80 backdrop-blur-[2px]"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#07131b] via-[#07131b]/70 to-[#07131b]/95"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-[#07131b] via-[#07131b]/50 to-[#07131b]"></div>
      </div>

      <div class="wrap relative z-10 py-16 sm:py-24">
        
        <!-- Breadcrumb & Top Bar -->
        <div class="mb-8 flex flex-wrap items-center justify-between gap-4 font-mono text-xs">
          <div class="flex items-center gap-2 text-slate-300">
            <Link href="/en" class="hover:text-accent transition-colors text-slate-300">Home</Link>
            <span class="text-slate-500">/</span>
            <Link href="/en/game" class="hover:text-accent transition-colors text-slate-300">Games</Link>
            <span class="text-slate-500">/</span>
            <span class="text-amber-400 font-semibold">{gameTitle}</span>
          </div>

          <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-1.5 border border-amber-500/50 bg-amber-500/15 px-3 py-1 text-amber-300 text-xs font-mono font-medium tracking-wide">
              <span class="h-2 w-2 rounded-full bg-amber-400 animate-ping"></span>
              CORE PROJECT · GODOT 4
            </span>
            <Link
              href="/game/sandeq-rush"
              class="border border-white/25 bg-white/10 px-3 py-1 text-white hover:text-amber-300 hover:border-amber-400/50 transition-colors text-xs font-medium"
              title="Switch to Indonesian"
            >
              Versi Bahasa Indonesia ↗
            </Link>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          
          <!-- Left Column -->
          <div class="lg:col-span-7 space-y-6">
            
            <!-- Game Logo & Icon Strip -->
            <div class="flex items-center gap-5">
              <div class="relative group shrink-0">
                <img
                  src="/games/sandeq-rush/sandeq-rush-icon-1024.png"
                  alt="Sandeq Rush App Icon"
                  class="h-20 w-20 sm:h-24 sm:w-24 rounded-2xl border-2 border-white/30 shadow-2xl object-cover bg-[#0d1d27]"
                />
                <span class="absolute -bottom-2 -right-2 bg-accent text-white font-mono text-[11px] font-bold px-2 py-0.5 rounded shadow-lg border border-white/20">
                  {version}
                </span>
              </div>
              <div>
                <img
                  src="/games/sandeq-rush/sandeq-rush-logo.png"
                  alt="Sandeq Rush Logo"
                  class="h-24 sm:h-32 md:h-36 w-auto object-contain drop-shadow-[0_12px_30px_rgba(0,0,0,0.85)] filter brightness-105"
                />
              </div>
            </div>

            <div class="space-y-3">
              <p class="font-mono text-xs uppercase tracking-widest text-amber-400 font-bold flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
                Arcade Racing · Mandar Wind Physics · Maritime Literacy
              </p>
              <h1 class="font-serif text-[clamp(2.25rem,5.5vw,4.5rem)] leading-[1.08] font-normal tracking-[-0.02em] text-white drop-shadow-md">
                Pilot Traditional Outrigger Racing Boats from West Sulawesi.
              </h1>
            </div>

            <p class="text-base sm:text-lg text-slate-200 leading-relaxed max-w-2xl font-normal drop-shadow">
              Harness the winds of the Makassar Strait reaching speeds up to 30+ knots in-game! Experience traditional Mandar sailing with realistic wind simulation, tactical zig-zag tacking, and active outrigger crew hiking.
            </p>

            <!-- CTA Buttons & Status Badge -->
            <div class="flex flex-wrap items-center gap-3 pt-2">
              {
                isReleased && playStoreUrl ? (
                  <a
                    href={playStoreUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2.5 border border-emerald-500 bg-emerald-600 px-6 py-3.5 font-mono text-xs font-bold text-white transition-all hover:bg-emerald-500 shadow-xl shadow-emerald-950/40"
                  >
                    <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                      <path d="M3.6 1.9c-.3.3-.5.8-.5 1.4v17.4c0 .6.2 1.1.5 1.4l.1.1 9.8-9.8v-.2L3.7 1.8l-.1.1zM17.1 15.7l-3.6-3.6v-.2l3.6-3.6.1.1 4.3 2.5c1.2.7 1.2 1.8 0 2.5l-4.4 2.3zM13.5 12.1L3.7 21.9c.4.4 1 .4 1.6.1l11.8-6.7-3.6-3.2zM13.5 11.9l3.6-3.2L5.3 2c-.6-.3-1.2-.3-1.6.1l9.8 9.8z"/>
                    </svg>
                    Download on Google Play →
                  </a>
                ) : (
                  <div class="inline-flex items-center gap-2.5 border border-amber-400/50 bg-amber-400/15 px-6 py-3.5 font-mono text-xs font-bold text-amber-300">
                    <span class="h-2 w-2 rounded-full bg-amber-400 animate-pulse"></span>
                    Coming Soon on Google Play
                  </div>
                )
              }
              <a
                href="#gameplay-video"
                class="inline-flex items-center gap-2 border border-accent bg-accent px-6 py-3.5 font-mono text-xs font-bold text-white transition-all hover:bg-sky-400 hover:shadow-xl hover:shadow-sky-950/40"
              >
                <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
                Watch Gameplay Preview
              </a>
              <a
                href="#etape"
                class="inline-flex items-center gap-2 border border-white/30 bg-white/10 px-5 py-3.5 font-mono text-xs font-medium text-white backdrop-blur-sm transition-all hover:border-white hover:bg-white/20"
              >
                5 Career Stages ↓
              </a>
              <a
                href="#galeri"
                class="inline-flex items-center gap-2 border border-white/30 bg-white/10 px-5 py-3.5 font-mono text-xs font-medium text-white backdrop-blur-sm transition-all hover:border-white hover:bg-white/20"
              >
                Screenshots ↓
              </a>
            </div>

            <!-- DJKI Copyright (Rendered once active) -->
            {
              showDjkiCertificate && (
                <div class="p-3 border border-amber-500/30 bg-amber-500/10 rounded font-mono text-xs text-amber-200 flex items-center gap-2">
                  <span class="text-amber-400 font-bold">✓ Copyright DJKI:</span>
                  <span>Registered under DJKI No. {djkiData.nomorPencatatan} ({djkiData.tanggalSertifikat})</span>
                </div>
              )
            }

            <!-- Quick Specs Row -->
            <div class="pt-4 flex flex-wrap gap-4 border-t border-white/15 font-mono text-xs text-slate-300">
              <div><strong class="text-white">Status:</strong> Coming Soon on Google Play (2026)</div>
              <div class="text-slate-600">•</div>
              <div><strong class="text-white">Engine:</strong> Godot 4.6.3</div>
              <div class="text-slate-600">•</div>
              <div><strong class="text-white">Controls:</strong> Dual Touch Screen Sliders</div>
            </div>

          </div>

          <!-- Right Column: Interactive Card Preview -->
          <div class="lg:col-span-5">
            <div class="relative overflow-hidden rounded-xl border border-white/20 bg-[#0c1c27]/95 p-5 shadow-2xl backdrop-blur-md">
              
              <!-- Card Header -->
              <div class="flex items-center justify-between border-b border-white/15 pb-3 font-mono text-xs text-slate-300">
                <span class="flex items-center gap-2 text-amber-400 font-bold">
                  <span class="h-2 w-2 rounded-full bg-amber-400 animate-pulse"></span>
                  RACE TELEMETRY
                </span>
                <span class="text-slate-400">MAKASSAR STRAIT</span>
              </div>

              <!-- Poster Graphic -->
              <div class="relative my-4 aspect-[16/10] overflow-hidden rounded-lg border border-white/20 bg-black group">
                <img
                  src="/games/sandeq-rush/screenshots/screenshot-kecepatan-penuh.png"
                  alt="Sandeq Rush In-Game Racing"
                  class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent flex items-end p-4">
                  <div class="font-mono text-xs text-white">
                    <span class="text-amber-400 font-bold">POSITION 1/4 · 30+ KNOTS</span>
                    <p class="text-slate-200 text-xs mt-0.5">Leading fleet along the Majene Coastal Stage</p>
                  </div>
                </div>
              </div>

              <!-- Quick Metric Stats -->
              <div class="grid grid-cols-3 gap-2 text-center font-mono text-xs">
                <div class="border border-white/15 bg-white/5 p-2 rounded">
                  <span class="block text-[10px] text-slate-400 uppercase">Top Speed</span>
                  <span class="text-sm font-bold text-amber-400">30+ Knots</span>
                </div>
                <div class="border border-white/15 bg-white/5 p-2 rounded">
                  <span class="block text-[10px] text-slate-400 uppercase">Race Stages</span>
                  <span class="text-sm font-bold text-white">5 (5,700 m)</span>
                </div>
                <div class="border border-white/15 bg-white/5 p-2 rounded">
                  <span class="block text-[10px] text-slate-400 uppercase">Encyclopedia</span>
                  <span class="text-sm font-bold text-emerald-400">12 Entries</span>
                </div>
              </div>

            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- GAMEPLAY TRAILER SECTION -->
    <section id="gameplay-video" class="py-16 sm:py-24 border-b border-rule bg-paper-2">
      <div class="wrap">
        
        <div class="max-w-3xl mb-8">
          <SectionLabel num="01" title="Gameplay Footage" />
          <h2 class="font-serif text-[clamp(2rem,4vw,3.25rem)] font-normal leading-tight text-ink mt-4 mb-3">
            Experience Sandeq Rush in Real-Time Action
          </h2>
          <p class="text-base text-ink-2 leading-relaxed">
            Direct gameplay recordings captured from the Godot Engine build. Watch how dynamic wind directions demand players adjust sail trim and shift crew ballast across outriggers in real time.
          </p>
        </div>

        <!-- Video Player Frame -->
        <div class="relative overflow-hidden border border-rule bg-[#07131b] shadow-2xl rounded-lg">
          
          <!-- Cockpit Header -->
          <div class="flex items-center justify-between border-b border-white/15 bg-[#0f212c] px-4 py-3 font-mono text-xs text-white">
            <div class="flex items-center gap-2">
              <span class="h-2.5 w-2.5 rounded-full bg-red-500"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-amber-500"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
              <span class="ml-2 font-semibold text-white">SANDEQ_RUSH_GAMEPLAY_RAW.MP4</span>
            </div>
            <div class="hidden sm:flex items-center gap-4 text-xs text-slate-300">
              <span>FPS: 60</span>
              <span>RESOLUTION: 1280x720</span>
              <span>AUDIO: STEREO</span>
            </div>
          </div>

          <!-- Video Element (Clean without raw fallback text leakage) -->
          <div class="relative aspect-video w-full bg-black">
            <video
              controls
              preload="metadata"
              poster="/games/sandeq-rush/video/sandeq-rush-hero-poster.jpg"
              class="h-full w-full object-contain"
            >
              <source src="/games/sandeq-rush/video/sandeq-rush-gameplay.mp4" type="video/mp4" />
            </video>
          </div>

          <!-- Video Footer Caption -->
          <div class="border-t border-white/15 bg-[#0f212c] p-4 text-xs font-mono text-slate-300 flex flex-wrap justify-between items-center gap-3">
            <span>Official Gameplay Footage Version 0.3.1 (Godot Engine Wind Mechanics)</span>
            <span class="text-amber-400 font-semibold">Developed by Alfandhy, S.T. — Polewali Mandar</span>
          </div>

        </div>

      </div>
    </section>

    <!-- MEKANIK & FISIKA ANGIN BERLAYAR -->
    <section class="py-16 sm:py-24 border-b border-rule">
      <div class="wrap">
        
        <div class="max-w-3xl mb-12">
          <SectionLabel num="02" title="Game Mechanics &amp; Physics" />
          <h2 class="font-serif text-[clamp(2rem,4vw,3.25rem)] font-normal leading-tight text-ink mt-4 mb-3">
            Bringing Traditional Nautical Physics to Life
          </h2>
          <p class="text-base text-ink-2 leading-relaxed">
            The Sandeq vessel is celebrated for its hydrodynamic hull profile and triangular lateen sail designed to capture high wind energy [SUMBER]. Sandeq Rush translates these maritime physics into an engaging and educational mobile arcade experience.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <div class="border border-rule bg-paper-2 p-6 flex flex-col justify-between">
            <div>
              <span class="font-mono text-xs text-accent font-semibold mb-2 block">01 / WIND ANGLE</span>
              <h3 class="font-serif text-xl text-ink font-normal mb-3">Lateen Sail Aerodynamics</h3>
              <p class="text-sm text-ink-2 leading-relaxed">
                Slide the left thumb controller upward to trim sails tight in gusting crosswinds, or ease sheets when headings shift to keep maximum propulsion.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-rule font-mono text-[11px] text-ink-2">
              Parameter: Angle of Attack &amp; Aerodynamic Lift
            </div>
          </div>

          <div class="border border-rule bg-paper-2 p-6 flex flex-col justify-between">
            <div>
              <span class="font-mono text-xs text-accent font-semibold mb-2 block">02 / OUTRIGGER BALANCING</span>
              <h3 class="font-serif text-xl text-ink font-normal mb-3">Active Crew Ballast</h3>
              <p class="text-sm text-ink-2 leading-relaxed">
                Heavy wind gusts heel the boat. Move the right slider to position your crew (pakkadacai) out onto windward outriggers to prevent capsizing.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-rule font-mono text-[11px] text-ink-2">
              Parameter: Torsional Moment &amp; Counterweight
            </div>
          </div>

          <div class="border border-rule bg-paper-2 p-6 flex flex-col justify-between">
            <div>
              <span class="font-mono text-xs text-accent font-semibold mb-2 block">03 / ZIG-ZAG TACKING</span>
              <h3 class="font-serif text-xl text-ink font-normal mb-3">Headwind Tacking Maneuver</h3>
              <p class="text-sm text-ink-2 leading-relaxed">
                When facing headwinds, sailboats cannot steer directly into the gale. Tap the tactical turn control to zig-zag across the course and slice upwind.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-rule font-mono text-[11px] text-ink-2">
              Parameter: Tacking Angle &amp; Turn Rate
            </div>
          </div>

          <div class="border border-rule bg-paper-2 p-6 flex flex-col justify-between">
            <div>
              <span class="font-mono text-xs text-accent font-semibold mb-2 block">04 / TOUCH ERGONOMICS</span>
              <h3 class="font-serif text-xl text-ink font-normal mb-3">Dual-Thumb Mobile Controls</h3>
              <p class="text-sm text-ink-2 leading-relaxed">
                Balanced dual-thumb tactile controls (left for sail trim, right for outrigger crew hiking) featuring adaptive notch safe-areas and haptic feedback.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-rule font-mono text-[11px] text-ink-2">
              Parameter: Touch Sliders &amp; Haptic Vibration
            </div>
          </div>

        </div>

