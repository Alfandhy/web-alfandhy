---
// Halaman Kebijakan Privasi Versi Bahasa Inggris — Privacy Policy
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import Link from '../../components/Link.astro';
import { SITE } from '../../data/site';

const lastUpdated = 'October 11, 2026';
---

<BaseLayout
  lang="en"
  title={`Privacy Policy — ${SITE.name}`}
  description="General privacy policy for the personal portfolio website alfandhy.my.id."
>
  <main class="py-16 sm:py-24">
    <div class="wrap max-w-3xl">
      <SectionLabel number="00" title="Legal Information" />

      <h1 class="font-serif text-[clamp(2.5rem,6vw,4.5rem)] font-normal leading-[1.08] tracking-[-0.02em] text-ink mt-8 mb-4">
        Privacy Policy
      </h1>
      <p class="font-mono text-xs text-ink-2 mb-12">Last updated: {lastUpdated}</p>

      <div class="space-y-10 text-base leading-relaxed text-ink/90 font-sans">
        <section class="border-t border-rule pt-6">
          <h2 class="font-serif text-2xl text-ink mb-3 font-normal">1. Scope</h2>
          <p class="text-ink-2">
            This Privacy Policy applies exclusively to the personal portfolio website <strong>alfandhy.my.id</strong>. 
            This website serves to showcase graphic design work, AI workflow explorations, educational materials, and creative ventures by Alfandhy.
          </p>
        </section>

        <section class="border-t border-rule pt-6">
          <h2 class="font-serif text-2xl text-ink mb-3 font-normal">2. Visitor Information &amp; Analytics</h2>
          <p class="text-ink-2">
            This website does not require account registration or collect personally identifiable information without your knowledge. 
            We may only analyze standard non-identifiable web telemetry (such as browser type, viewport resolution, and visited pages) solely to maintain performance and visual integrity.
          </p>
        </section>

        <section class="border-t border-rule pt-6">
          <h2 class="font-serif text-2xl text-ink mb-3 font-normal">3. Standalone Applications &amp; Games</h2>
          <p class="text-ink-2">
            Distinct digital products such as standalone games (including <strong>Sandeq Rush</strong>) operate under dedicated privacy policies formulated in accordance with distribution platforms (e.g., Google Play Store). 
            Specific privacy policies for those games are accessible directly on their designated pages within this site.
          </p>
        </section>

        <section class="border-t border-rule pt-6">
          <h2 class="font-serif text-2xl text-ink mb-3 font-normal">4. Direct Correspondence</h2>
          <p class="text-ink-2">
            If you initiate contact via email or through the linked professional profiles, your contact information is utilized strictly to reply to your inquiry or discuss professional collaborations. We never share or sell contact details to third parties.
          </p>
        </section>

        <section class="border-t border-rule pt-6">
          <h2 class="font-serif text-2xl text-ink mb-3 font-normal">5. Questions &amp; Contact</h2>
          <p class="text-ink-2">
            If you have any questions regarding privacy on this website, please direct correspondence to:
          </p>
          <p class="mt-3">
            <Link href="mailto:halo@alfandhy.my.id" class="text-ink font-mono text-sm underline">halo@alfandhy.my.id</Link>
          </p>
        </section>
      </div>

      <div class="mt-16 border-t border-rule pt-8">
        <Link href="/en" class="text-sm font-mono text-ink">← Return to Homepage</Link>
      </div>
    </div>
  </main>
</BaseLayout>
