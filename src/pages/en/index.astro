---
// Halaman Beranda (EN) — English Version of Homepage
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import WorkRow from '../../components/WorkRow.astro';
import Link from '../../components/Link.astro';
import { SITE, SOCIALS } from '../../data/site';
import { DICT } from '../../data/i18n';
import imgAlfandhy from '../../assets/images/alfandhy.png';

const t = DICT.en;

const featured = (await getCollection('work', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 1);

const nowDate = new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' }).format(new Date());

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Alfandhy',
  honorificSuffix: 'S.T.',
  url: `${SITE.url}/en`,
  jobTitle: 'AI Enthusiast, Educator, Game Developer',
  address: { '@type': 'PostalAddress', addressLocality: 'Polewali Mandar', addressRegion: 'West Sulawesi', addressCountry: 'ID' },
  knowsAbout: ['Artificial Intelligence', 'Prompt Engineering', 'Visual Communication Design', 'Game Development'],
  sameAs: SOCIALS.map((s) => s.href).filter((h) => !h.startsWith('[')),
};
---

<BaseLayout
  lang="en"
  title={`${SITE.name} — AI Enthusiast · Design · Edu · Games`}
  description={t.meta.description}
  jsonLd={personLd}
>
  <!-- HERO -->
  <section class="pt-12 pb-[88px] sm:pt-[72px] sm:pb-[120px]">
    <div class="wrap">
      <p class="label r mb-10">{t.hero.badge}</p>
      <div class="grid grid-cols-1 items-end gap-8 lg:grid-cols-12">
        <div class="r lg:col-span-8">
          <h1 class="display">
            {t.hero.headlinePre}<em>{t.hero.headlineEmp}</em>{t.hero.headlinePost}
          </h1>
        </div>

        <div class="r grid grid-cols-1 items-end gap-5 sm:grid-cols-[1fr_1.2fr] lg:col-span-4 lg:block">
          <div class="portrait relative flex aspect-[4/5] items-end overflow-hidden border border-rule bg-paper-2">
            <Image src={imgAlfandhy} alt={t.hero.altPhoto} class="absolute inset-0 h-full w-full object-cover saturate-[.85]" />
          </div>
          <div>
            <p class="text-base text-ink-2 lg:mt-5">
              {t.hero.bio}
            </p>
            <Link href="/en#karya" id="hero-work-link" class="mt-3.5 inline-block text-base text-ink">{t.hero.ctaWork}</Link>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 01 — SELECTED WORK -->
  <section id="karya" class="pb-[88px] sm:pb-[140px]">
    <div class="wrap">
      <SectionLabel num={t.karya.sectionNum} title={t.karya.sectionTitle}>
        <Link href="/en/game/sandeq-rush" class="label">Game page →</Link>
      </SectionLabel>
      <div>
        {
          featured.map((w, i) => (
            <WorkRow
              num={String(i + 1).padStart(2, '0')}
              title={w.data.title}
              summary={w.data.summary}
              href={w.id === 'sandeq-rush' ? '/en/game/sandeq-rush' : (w.data.href ?? `/work/${w.id}`)}
              tags={w.data.tags}
              cover={w.data.cover}
              coverAlt={w.data.coverAlt}
              placeholder={w.data.placeholder}
              placeholderLabel={w.data.placeholderLabel}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- 02 — HOW I COLLABORATE WITH AI -->
  <section id="pendekatan" class="pb-[88px] sm:pb-[140px]">
    <div class="wrap">
      <SectionLabel num={t.approach.sectionNum} title={t.approach.sectionTitle} />
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-6">
        <ul class="r lg:col-span-4">
          {
            t.approach.items.map((item, i) => (
              <li class="flex items-baseline justify-between border-b border-rule py-3.5 font-serif text-[1.375rem]">
                {item}
                <span class="font-mono text-xs text-ink-2">{String(i + 1).padStart(2, '0')}</span>
              </li>
            ))
          }
        </ul>
        <div class="r space-y-[1em] font-serif text-[clamp(1.375rem,2.2vw,1.875rem)] leading-[1.35] font-light tracking-[-0.005em] lg:col-span-6 lg:col-start-6">
          <p>
            {t.approach.quote1}<em class="text-accent">{t.approach.quote1Emp}</em>{t.approach.quote1Post}
          </p>
          <p>
            {t.approach.quote2}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 — NOW -->
  <section id="sekarang" class="pb-[88px] sm:pb-[140px]">
    <div class="wrap">
      <SectionLabel num={t.now.sectionNum} title={t.now.sectionTitle}>
        <span class="label">{nowDate}</span>
      </SectionLabel>
      <dl class="r grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-6">
        {
          t.now.items.map((n) => (
            <div>
              <dt class="label mb-2">{n.label}</dt>
              <dd class="max-w-[30ch]">{n.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .portrait::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(135deg, transparent 0 14px, rgb(22 20 15 / 0.04) 14px 15px);
  }
</style>
