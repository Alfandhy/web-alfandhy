---
// Halaman tautan toko ala Linktree — /shop (bahasa Inggris saja, untuk audiens global).
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SOCIALS, SHOP_LINKS, CONTACT } from '../data/site';
import SocialIcon from '../components/SocialIcon.astro';
import { TRENDING } from '../data/trending';
import { loadTrending } from '../lib/etsy';

const trending = await loadTrending(TRENDING);
// Satu produk → kartu lebar (gambar kiri, teks kanan); dua atau lebih → grid 2 kolom.
const solo = trending.length === 1;

const title = 'Shop — Alfandhy';
const description = 'Digital products by Alfandhy: templates, printables, PNG assets and graphic resources on Etsy and Gumroad.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  url: `${SITE.url}/shop/`,
  inLanguage: 'en',
  about: { '@id': `${SITE.url}/#person` },
  sameAs: SOCIALS.map((s) => s.href),
  hasPart: SHOP_LINKS.map((s) => ({ '@type': 'WebPage', name: `${SITE.name} on ${s.label}`, url: s.href })),
};
---

<BaseLayout lang="en" {title} {description} {jsonLd} bare alternates={false}>
  <div class="mx-auto flex min-h-dvh w-full max-w-[480px] flex-col px-4 pt-14 pb-10 sm:pt-20">
    <!-- Sambutan -->
    <header class="text-center">
      <p class="font-mono text-xs tracking-[0.14em] text-accent uppercase">Alfandhy Studio</p>
      <h1 class="mt-4 text-[2rem] leading-[1.1] font-semibold tracking-[-0.03em] sm:text-[2.5rem]">
        Welcome — glad you're here!
      </h1>
      <p class="mx-auto mt-4 max-w-[36ch] text-[0.9375rem] text-ink-2">
        Patterns, templates and PNG assets made to save you time. Instant download, ready to use in your next project.
        Pick a store below and happy shopping.
      </p>
    </header>

    <!-- Toko: logo masing-masing -->
    <ul class="mt-10 grid grid-cols-2 gap-3">
      {
        SHOP_LINKS.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              data-shop={s.id}
              class="group flex h-full flex-col items-center rounded-sm border border-rule bg-paper-2 px-3 pt-6 pb-5 text-center transition-colors hover:border-accent"
              style={`--brand:${s.color}`}
            >
              {s.id === 'gumroad' ? (
                <SocialIcon id="gumroad" class="size-20 text-[var(--brand)] transition-transform duration-300 group-hover:scale-105" />
              ) : (
                <span class="flex size-20 items-center justify-center rounded-full bg-[var(--brand)] text-white transition-transform duration-300 group-hover:scale-105">
                  <SocialIcon id={s.id} class="size-9" />
                </span>
              )}
              <span class="mt-4 block font-semibold text-ink">{s.label}</span>
              <span class="mt-1 block text-[0.8125rem] leading-snug text-ink-2">{s.desc}</span>
              <span class="mt-3 font-mono text-[11px] text-ink-2 transition-colors group-hover:text-accent">Visit store ↗</span>
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Produk trending -->
    {trending.length > 0 && (
      <section class="mt-8 rounded-sm border border-rule bg-paper-2 p-4" aria-labelledby="trending">
        <h2 id="trending" class="mb-4 flex items-center gap-2 text-sm font-semibold">
          <span class="relative flex size-2">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-60"></span>
            <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
          </span>
          Trending now
        </h2>
        <ul class:list={['grid gap-3', solo ? 'grid-cols-1' : 'grid-cols-2']}>
          {trending.map((p) => (
            <li>
              <a href={p.url} target="_blank" rel="noopener" class:list={['group', solo ? 'flex items-center gap-4' : 'block']}>
                <span class:list={['relative block aspect-square overflow-hidden rounded-sm border border-rule bg-paper', solo && 'w-32 shrink-0']}>
                  {p.image ? (
                    /^https?:/.test(p.image) ? (
                      <Image
                        src={p.image}
                        alt={p.title}
                        inferSize
                        widths={[220, 440]}
                        sizes="(min-width: 480px) 210px, 45vw"
                        class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
                      />
                    ) : (
                      <img src={p.image} alt={p.title} loading="lazy" class="size-full object-cover" />
                    )
                  ) : (
                    <span class="flex size-full items-center justify-center text-[#F1641E]">
                      <SocialIcon id="etsy" class="size-10 opacity-60" />
                    </span>
                  )}
                  {p.badge && (
                    <span class="absolute top-2 left-2 rounded-sm bg-paper/85 px-1.5 py-0.5 font-mono text-[10px] text-ink">{p.badge}</span>
                  )}
                </span>
                <span class:list={['block', !solo && 'mt-2']}>
                  <span class:list={['line-clamp-2 block leading-snug text-ink transition-colors group-hover:text-accent', solo ? 'text-[0.9375rem] font-semibold' : 'text-[0.8125rem]']}>{p.title}</span>
                  {p.price && <span class="mt-0.5 block font-mono text-xs text-ink-2">{p.price}</span>}
                  {solo && <span class="mt-2 block font-mono text-[11px] text-ink-2 transition-colors group-hover:text-accent">View on Etsy ↗</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Media sosial -->
    <section class="mt-12" aria-labelledby="follow">
      <h2 id="follow" class="label mb-4 text-center">Follow &amp; connect</h2>
      <ul class="grid grid-cols-2 gap-3">
        {SOCIALS.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="me noopener"
              class="flex items-center gap-3 rounded-sm border border-rule bg-paper-2 px-4 py-3 text-sm font-medium text-ink transition-colors hover:border-accent hover:text-accent"
            >
              <SocialIcon id={s.id} class="size-5 shrink-0" />
              {s.label}
            </a>
          </li>
        ))}
      </ul>
      <ul class="mt-6 flex justify-center gap-6 text-sm">
        <li>
          <a href="/en/" class="flex items-center gap-2 text-ink-2 transition-colors hover:text-accent">
            <SocialIcon id="web" class="size-4" />Website
          </a>
        </li>
        <li>
          <a href={`mailto:${CONTACT.email}`} class="flex items-center gap-2 text-ink-2 transition-colors hover:text-accent">
            <SocialIcon id="email" class="size-4" />Email
          </a>
        </li>
      </ul>
    </section>

    <footer class="mt-auto pt-12 text-center font-mono text-[11px] text-ink-2/70">
      © {new Date().getFullYear()} {SITE.name}
    </footer>
  </div>
</BaseLayout>
