---
// Halaman tautan toko ala Linktree — /shop (bahasa Inggris saja, untuk audiens global).
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SOCIALS, SHOP_LINKS, CONTACT } from '../data/site';
import SocialIcon from '../components/SocialIcon.astro';
import imgAlfandhy from '../assets/images/alfandhy.png';

const title = 'Shop — Alfandhy';
const description = 'Digital products by Alfandhy: templates, printables, PNG assets and graphic resources on Etsy and Gumroad.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  url: `${SITE.url}/shop/`,
  inLanguage: 'en',
  about: { '@id': `${SITE.url}/#person` },
  sameAs: SOCIALS.map((s) => s.href),
  hasPart: SHOP_LINKS.map((s) => ({ '@type': 'WebPage', name: `${SITE.name} on ${s.label}`, url: s.href })),
};
---

<BaseLayout lang="en" {title} {description} {jsonLd} bare alternates={false}>
  <div class="mx-auto flex min-h-dvh w-full max-w-[480px] flex-col px-4 pt-14 pb-10 sm:pt-20">
    <!-- Profil -->
    <header class="flex flex-col items-center text-center">
      <Image
        src={imgAlfandhy}
        alt="Portrait of Alfandhy"
        widths={[96, 192]}
        sizes="96px"
        loading="eager"
        fetchpriority="high"
        class="size-24 rounded-full border border-rule object-cover object-top"
      />
      <h1 class="mt-5 text-2xl font-semibold tracking-[-0.02em]">{SITE.name}</h1>
      <p class="mt-1 font-mono text-xs text-accent">Digital Products &amp; Creative Assets</p>
      <p class="mt-4 max-w-[34ch] text-[0.9375rem] text-ink-2">Ready-to-use digital goods for your projects — pick a store below.</p>
    </header>

    <!-- Tautan toko -->
    <ul class="mt-10 flex flex-col gap-3">
      {
        SHOP_LINKS.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              data-shop={s.id}
              class:list={[
                'group flex items-center gap-4 rounded-sm border px-5 py-4 transition-colors',
                s.featured
                  ? 'border-accent bg-accent/10 hover:bg-accent/20'
                  : 'border-rule bg-paper-2 hover:border-accent',
              ]}
            >
              <span
                class:list={[
                  'flex size-11 shrink-0 items-center justify-center rounded-full font-mono text-sm font-medium',
                  s.featured ? 'bg-accent text-paper' : 'border border-rule text-ink',
                ]}
                aria-hidden="true"
              >
                {s.label.charAt(0)}
              </span>
              <span class="min-w-0 flex-1">
                <span class="block font-semibold text-ink">{s.label}</span>
                <span class="block text-sm leading-snug text-ink-2">{s.desc}</span>
              </span>
              <span class="shrink-0 font-mono text-xs text-ink-2 transition-colors group-hover:text-accent">Visit ↗</span>
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Media sosial -->
    <section class="mt-12" aria-labelledby="follow">
      <h2 id="follow" class="label mb-4 text-center">Follow &amp; connect</h2>
      <ul class="grid grid-cols-2 gap-3">
        {SOCIALS.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="me noopener"
              class="flex items-center gap-3 rounded-sm border border-rule bg-paper-2 px-4 py-3 text-sm font-medium text-ink transition-colors hover:border-accent hover:text-accent"
            >
              <SocialIcon id={s.id} class="size-5 shrink-0" />
              {s.label}
            </a>
          </li>
        ))}
      </ul>
      <ul class="mt-6 flex justify-center gap-6 text-sm">
        <li>
          <a href="/en/" class="flex items-center gap-2 text-ink-2 transition-colors hover:text-accent">
            <SocialIcon id="web" class="size-4" />Website
          </a>
        </li>
        <li>
          <a href={`mailto:${CONTACT.email}`} class="flex items-center gap-2 text-ink-2 transition-colors hover:text-accent">
            <SocialIcon id="email" class="size-4" />Email
          </a>
        </li>
      </ul>
    </section>

    <footer class="mt-auto pt-12 text-center font-mono text-[11px] text-ink-2/70">
      © {new Date().getFullYear()} {SITE.name}
    </footer>
  </div>
</BaseLayout>
