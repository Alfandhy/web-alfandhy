---
// Halaman Kebijakan Privasi Khusus Game Sandeq Rush (ID)
// URL ini digunakan untuk Google Play Console
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionLabel from '../../../components/SectionLabel.astro';
import Link from '../../../components/Link.astro';
import { SITE } from '../../../data/site';

const gameTitle = 'Sandeq Rush';
const effectiveDate = '11 Oktober 2026';
---

<BaseLayout
  title={`Kebijakan Privasi Game ${gameTitle} — Alfandhy`}
  description={`Kebijakan privasi resmi untuk game mobile Android ${gameTitle} oleh Alfandhy.`}
>
  <main class="py-16 sm:py-24">
    <div class="wrap max-w-3xl">
      
      <div class="mb-6 flex items-center gap-2 font-mono text-xs text-ink-2">
        <Link href="/game/sandeq-rush" class="hover:text-accent">← Kembali ke {gameTitle}</Link>
        <span>/</span>
        <span class="text-accent font-semibold">Kebijakan Privasi Game</span>
      </div>

      <SectionLabel number="GAME-POL" title="Kebijakan Privasi Aplikasi Mobile" />

      <h1 class="font-serif text-[clamp(2.5rem,6vw,4.5rem)] font-normal leading-[1.08] tracking-[-0.02em] text-ink mt-8 mb-4">
        Kebijakan Privasi: {gameTitle}
      </h1>
      <p class="font-mono text-xs text-ink-2 mb-12">Berlaku sejak: {effectiveDate} · Pengembang: Alfandhy, S.T.</p>

      <div class="space-y-10 text-base leading-relaxed text-ink/90 font-sans">
        <section class="border-t border-rule pt-6">
          <h2 class="font-serif text-2xl text-ink mb-3 font-normal">1. Pendahuluan</h2>
          <p class="text-ink-2">
            Kebijakan Privasi ini menjelaskan bagaimana game mobile <strong>{gameTitle}</strong> (dikembangkan oleh Alfandhy) menangani informasi pengguna saat Anda mengunduh, menginstal, atau memainkan game melalui Google Play Store. Kami berkomitmen menjaga privasi pemain kami, terutama pengguna usia anak dan keluarga.
          </p>
        </section>

        <section class="border-t border-rule pt-6">
          <h2 class="font-serif text-2xl text-ink mb-3 font-normal">2. Informasi yang Dikumpulkan</h2>
          <p class="text-ink-2 mb-3">
            Game <strong>{gameTitle}</strong> dirancang sebagai game arcade edukasi tanpa keharusan login akun pribadi. Secara umum:
          </p>
          <ul class="list-disc pl-6 space-y-2 text-ink-2">
            <li><strong>Data Lokal Perangkat:</strong> Skor tertinggi, progres etape, dan konfigurasi perahu disimpan secara lokal pada penyimpanan internal perangkat Anda (Local Storage / SQLite).</li>
            <li><strong>Telemetri Standar (Non-Pribadi):</strong> Layanan pihak ketiga (seperti Google Play Services) dapat mengumpulkan data teknis anonim seperti tipe perangkat keras, versi OS Android, dan laporan error (*crash logs*) untuk stabilitas gameplay.</li>
          </ul>
        </section>

        <section class="border-t border-rule pt-6">
          <h2 class="font-serif text-2xl text-ink mb-3 font-normal">3. Privasi Anak (Children's Privacy)</h2>
          <p class="text-ink-2">
            Game ini ramah keluarga dan tidak menargetkan pengumpulan data identifikasi pribadi (*Personally Identifiable Information*) dari anak-anak di bawah umur 13 tahun (atau batas usia yang berlaku di yurisdiksi Anda). Semua fitur permainan dapat dinikmati tanpa verifikasi identitas pribadi.
          </p>
        </section>

        <section class="border-t border-rule pt-6">
          <h2 class="font-serif text-2xl text-ink mb-3 font-normal">4. Layanan Pihak Ketiga &amp; Izin Perangkat</h2>
          <p class="text-ink-2 mb-2">
            Game ini dapat berinteraksi dengan:
          </p>
          <ul class="list-disc pl-6 space-y-1 text-ink-2">
            <li><strong>Google Play Services:</strong> Untuk sinkronisasi prestasi (Achievements) dan papan peringkat jika fitur tersebut diaktifkan oleh pemain.</li>
          </ul>
          <p class="text-ink-2 mt-3">
            Game tidak meminta izin akses lokasi presisi (GPS), kamera, atau buku kontak Anda.
          </p>
        </section>

        <section class="border-t border-rule pt-6">
          <h2 class="font-serif text-2xl text-ink mb-3 font-normal">5. Hubungi Pengembang</h2>
          <p class="text-ink-2">
            Jika ada pertanyaan mengenai kebijakan privasi atau permohonan data terkait game {gameTitle}, silakan hubungi pengembang melalui:
          </p>
          <p class="mt-3 font-mono text-sm">
            Email: <Link href="mailto:halo@alfandhy.my.id" class="text-accent underline">halo@alfandhy.my.id</Link>
          </p>
        </section>
      </div>

      <div class="mt-16 border-t border-rule pt-8 flex items-center justify-between">
        <Link href="/game/sandeq-rush" class="text-sm font-mono text-ink">← Halaman Game Sandeq Rush</Link>
        <Link href="/en/game/sandeq-rush/privacy" class="text-sm font-mono text-ink-2 hover:text-accent">English Version →</Link>
      </div>
    </div>
  </main>
</BaseLayout>
