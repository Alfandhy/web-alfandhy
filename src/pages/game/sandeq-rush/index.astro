---
// Halaman Showcase Khusus Game Sandeq Rush (ID)
// Merangkum seluruh aset, video, logo, dan panduan teknis dari Press Kit
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionLabel from '../../../components/SectionLabel.astro';
import Link from '../../../components/Link.astro';

const gameTitle = 'Sandeq Rush';
const releaseYear = '2026';
const version = 'v0.3.1';
const engine = 'Godot Engine 4.6.3';
const platform = 'Android 16 (API Level 36) · Google Play';
const genre = 'Arcade Sailing Racing · Cultural Maritime Edu';

// --- Konfigurasi Status Distribusi & Hak Cipta ---
// Ubah isReleased ke true dan isi playStoreUrl jika game sudah tayang di Google Play Store
const isReleased = false;
const playStoreUrl: string | null = null; // Contoh: 'https://play.google.com/store/apps/details?id=id.sandeqrush.game'

// Ubah showDjkiCertificate ke true setelah nomor dan tanggal sertifikat resmi terbit
const showDjkiCertificate = false;
const djkiData = {
  nomorPencatatan: '[NOMOR PENCATATAN DJKI]',
  tanggalSertifikat: '[TANGGAL SERTIFIKAT DJKI]',
  pemegangHakCipta: 'Alfandhy, S.T.',
  jenisCiptaan: 'Permainan Video (Video Game)',
};

const stages = [
  {
    num: '01',
    name: 'Teluk Polewali',
    distance: '900 meter',
    wind: 'Angin samping kiri (13 knot)',
    desc: 'Lintasan pemanasan di perairan teluk yang tenang. Belajar mengendalikan slider layar dan menjaga keseimbangan awak di cadik.',
    accent: 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400',
  },
  {
    num: '02',
    name: 'Pesisir Majene',
    distance: '1.100 meter',
    wind: 'Angin berbalik arah di tengah lintasan',
    desc: 'Bersaing adu cepat melawan 3 perahu rival (Pambusuang, Tinambung, Majene) hingga kecepatan 30+ knot di perairan pesisir.',
    accent: 'bg-sky-500/10 border-sky-500/30 text-sky-400',
  },
  {
    num: '03',
    name: 'Tanjung Rangas',
    distance: '1.000 meter',
    wind: 'Angin depan (Headwind)',
    desc: 'Tantangan taktis navigasi. Saat angin datang dari haluan depan, lakukan manuver pindah haluan (tacking) secara zig-zag.',
    accent: 'bg-amber-500/10 border-amber-500/30 text-amber-400',
  },
  {
    num: '04',
    name: 'Selat Makassar',
    distance: '1.400 meter',
    wind: 'Angin laut lepas berputar-putar',
    desc: 'Ombak laut lepas dan hembusan angin dinamis. Keseimbangan awak di cadik diuji maksimal agar perahu tidak terbalik.',
    accent: 'bg-purple-500/10 border-purple-500/30 text-purple-400',
  },
  {
    num: '05',
    name: 'Pantai Losari (Makassar)',
    distance: '1.300 meter',
    wind: 'Angin kencang garis finis',
    desc: 'Etape pamungkas terinspirasi garis finis lomba Sandeq Race tahunan Sulawesi Barat menuju pesisir ikonik Makassar.',
    accent: 'bg-accent/15 border-accent/40 text-accent',
  },
];

const screenshots = [
  {
    src: '/games/sandeq-rush/screenshots/screenshot-menu-utama.png',
    title: 'Menu Utama & Profil Pelaut',
    caption: 'Tampilan antarmuka beranda dengan logo 3D, pilihan Karier Sandeq Race, Tutorial, dan Papan Skor.',
  },
  {
    src: '/games/sandeq-rush/screenshots/screenshot-peta-etape.png',
    title: 'Peta 5 Etape Karier & Koleksi Bintang',
    caption: 'Pemilihan rute pelayaran dari Teluk Polewali hingga Pantai Losari dengan sistem klasemen waktu.',
  },
  {
    src: '/games/sandeq-rush/screenshots/screenshot-tutorial.png',
    title: 'Tutorial Interaktif Berpemandu',
    caption: 'Panduan ramah pemula untuk mempelajari kontrol ganda slider Layar dan penyeimbang Awak di cadik.',
  },
  {
    src: '/games/sandeq-rush/screenshots/screenshot-balapan-majene.png',
    title: 'Balapan Sengit 4 Armada di Majene',
    caption: 'Adu kencang bersama perahu tradisi rival di perairan Pesisir Majene dengan cipratan buih ombak dinamis.',
  },
  {
    src: '/games/sandeq-rush/screenshots/screenshot-kecepatan-penuh.png',
    title: 'Aksi Melaju di Kecepatan 30+ Knot',
    caption: 'Memaksimalkan tangkapan angin samping untuk memimpin balapan di posisi terdepan.',
  },
  {
    src: '/games/sandeq-rush/screenshots/screenshot-hasil-lomba.png',
    title: 'Podium Finis & Fakta Budaya Edukatif',
    caption: 'Catatan waktu finis terbaik disertai kartu edukasi pengetahuan budaya maritim suku Mandar.',
  },
  {
    src: '/games/sandeq-rush/screenshots/screenshot-ensiklopedia.png',
    title: 'Ensiklopedia Maritim Sandeq',
    caption: 'Arsip literasi sejarah perahu Sandeq, anatomi cadik, teknik berlayar, dan tradisi Passandeq.',
  },
  {
    src: '/games/sandeq-rush/screenshots/screenshot-menu-jeda.png',
    title: 'Menu Jeda & Safe-Area Android',
    caption: 'Desain responsif yang menjaga jarak dari kamera poni (notch) serta fitur auto-pause saat notifikasi.',
  },
];

const boats = [
  {
    src: '/games/sandeq-rush/game-assets/perahu/boat_player.png',
    name: 'Perahu Pemain (Merah-Putih)',
    role: 'Sandeq Utama Pemain',
    desc: 'Layar segitiga bercorak catur merah-putih dengan cadik bambu ganda yang lincah.',
  },
  {
    src: '/games/sandeq-rush/game-assets/perahu/rival_blue.png',
    name: 'Passandeq Pambusuang (Biru)',
    role: 'Armada Rival 01',
    desc: 'Dikenal dengan stabilitas tinggi saat melintasi ombak besar perairan Majene.',
  },
  {
    src: '/games/sandeq-rush/game-assets/perahu/rival_yellow.png',
    name: 'Layar Tinambung (Kuning-Hitam)',
    role: 'Armada Rival 02',
    desc: 'Memiliki akselerasi cepat dalam memanfaatkan hembusan angin belakang.',
  },
  {
    src: '/games/sandeq-rush/game-assets/perahu/rival_green.png',
    name: 'Angin Majene (Hijau)',
    role: 'Armada Rival 03',
    desc: 'Tangguh dalam manuver haluan zig-zag (tacking) saat menghadapi angin depan.',
  },
];

const encyclopedias = [
  {
    term: 'Sandeq',
    category: 'Perahu',
    text: 'Berasal dari kata Mandar yang berarti "runcing", merujuk pada bentuk haluan dan lambung perahu yang sangat ramping untuk menembus air dengan hambatan minimal.',
  },
  {
    term: 'Sombal (Layar Segitiga)',
    category: 'Anatomi',
    text: 'Layar segitiga khas yang dipasang miring ke depan. Desain ini menangkap daya angkat aerodinamis mirip sayap pesawat untuk menghasilkan laju yang bertenaga.',
  },
  {
    term: 'Palatto & Barat (Cadik)',
    category: 'Keseimbangan',
    text: 'Sayap penyeimbang di sisi kiri dan kanan perahu berbahan bambu petung utuh. Menjaga perahu tetap seimbang saat dimiringkan oleh hembusan angin kencang.',
  },
  {
    term: 'Passandeq & Pakkadacai',
    category: 'Awak Kapal',
    text: 'Pelaut Mandar yang piawai. Awak berdiri dan berpindah ke atas cadik yang terangkat untuk memanfaatkan bobot tubuh sebagai penyeimbang momen gaya angin.',
  },
  {
    term: 'Pindah Haluan (Tacking)',
    category: 'Navigasi',
    text: 'Manuver berlayar zig-zag ketika perahu harus menuju ke arah asal datangnya angin. Membutuhkan koordinasi cepat memindahkan layar dan awak perahu.',
  },
  {
    term: 'Tradisi Lomba Sandeq Race',
    category: 'Warisan Budaya',
    text: 'Ajang pelayaran perahu layar tradisional di Sulawesi Barat yang menempuh etape pesisir Selat Makassar hingga pesisir Makassar.',
  },
];
const videoGameLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: gameTitle,
  description:
    'Game balap arcade perahu layar tradisional Sandeq Mandar untuk Android dengan simulasi fisika arah angin, 5 etape balapan, dan ensiklopedia maritim edukatif.',
  genre: ['Arcade Racing', 'Educational', 'Maritime Simulation'],
  gamePlatform: ['Android'],
  operatingSystem: 'Android 10 and above',
  applicationCategory: 'Game',
  author: {
    '@type': 'Person',
    name: 'Alfandhy',
    url: 'https://alfandhy.my.id',
  },
  inLanguage: ['id', 'en'],
  playMode: 'SinglePlayer',
};
---

<BaseLayout
  jsonLd={videoGameLd}
  title={`${gameTitle} — Game Edukatif Balap Perahu Layar Sandeq Mandar`}
  description="Sandeq Rush adalah game balap arcade perahu layar tradisional Sandeq Mandar untuk Android. Rasakan sensasi fisika angin selat Makassar hingga 30+ knot di dalam game, mode karier 5 etape (total 5.700 m), dan ensiklopedia maritim."
>
  <main class="relative bg-paper text-ink overflow-hidden">

    <!-- HERO SECTION -->
    <section class="relative min-h-[85vh] lg:min-h-[92vh] flex items-center justify-center overflow-hidden border-b border-rule bg-[#07131b]">
      
      <!-- Video Loop Background -->
      <div class="absolute inset-0 z-0 overflow-hidden">
        <video
          autoplay
          loop
          muted
          playsinline
          poster="/games/sandeq-rush/video/sandeq-rush-hero-poster.jpg"
          class="h-full w-full object-cover opacity-20 filter brightness-[0.4] contrast-[1.25] saturate-[0.8]"
        >
          <source src="/games/sandeq-rush/video/sandeq-rush-hero-loop.mp4" type="video/mp4" />
        </video>
        <!-- Dark Deep-Sea Gradient Overlays -->
        <div class="absolute inset-0 bg-[#07131b]/80 backdrop-blur-[2px]"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#07131b] via-[#07131b]/70 to-[#07131b]/95"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-[#07131b] via-[#07131b]/50 to-[#07131b]"></div>
      </div>

      <div class="wrap relative z-10 py-16 sm:py-24">
        
        <!-- Breadcrumb & Top Bar -->
        <div class="mb-8 flex flex-wrap items-center justify-between gap-4 font-mono text-xs">
          <div class="flex items-center gap-2 text-slate-300">
            <Link href="/" class="hover:text-accent transition-colors text-slate-300">Beranda</Link>
            <span class="text-slate-500">/</span>
            <Link href="/game" class="hover:text-accent transition-colors text-slate-300">Game</Link>
            <span class="text-slate-500">/</span>
            <span class="text-amber-400 font-semibold">{gameTitle}</span>
          </div>

          <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-1.5 border border-amber-500/50 bg-amber-500/15 px-3 py-1 text-amber-300 text-xs font-mono font-medium tracking-wide">
              <span class="h-2 w-2 rounded-full bg-amber-400 animate-ping"></span>
              PROYEK UTAMA · GODOT 4
            </span>
            <Link
              href="/en/game/sandeq-rush"
              class="border border-white/25 bg-white/10 px-3 py-1 text-white hover:text-amber-300 hover:border-amber-400/50 transition-colors text-xs font-medium"
              title="Switch to English"
            >
              EN Version ↗
            </Link>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          
          <!-- Left Column: Big Logo, Headline, Intro -->
          <div class="lg:col-span-7 space-y-6">
            
            <!-- Game Logo & Icon Strip -->
            <div class="flex items-center gap-5">
              <div class="relative group shrink-0">
                <img
                  src="/games/sandeq-rush/sandeq-rush-icon-1024.png"
                  alt="Ikon Sandeq Rush"
                  class="h-20 w-20 sm:h-24 sm:w-24 rounded-2xl border-2 border-white/30 shadow-2xl object-cover bg-[#0d1d27]"
                />
                <span class="absolute -bottom-2 -right-2 bg-accent text-white font-mono text-[11px] font-bold px-2 py-0.5 rounded shadow-lg border border-white/20">
                  {version}
                </span>
              </div>
              <div>
                <img
                  src="/games/sandeq-rush/sandeq-rush-logo.png"
                  alt="Sandeq Rush Logo"
                  class="h-24 sm:h-32 md:h-36 w-auto object-contain drop-shadow-[0_12px_30px_rgba(0,0,0,0.85)] filter brightness-105"
                />
              </div>
            </div>

            <div class="space-y-3">
              <p class="font-mono text-xs uppercase tracking-widest text-amber-400 font-bold flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
                Arcade Racing · Fisika Angin Mandar · Literasi Maritim
              </p>
              <h1 class="font-serif text-[clamp(2.25rem,5.5vw,4.5rem)] leading-[1.08] font-normal tracking-[-0.02em] text-white drop-shadow-md">
                Kemudikan Perahu Bercadik Tradisional dari Pesisir Mandar.
              </h1>
            </div>

            <p class="text-base sm:text-lg text-slate-200 leading-relaxed max-w-2xl font-normal drop-shadow">
              Tembus ombak Selat Makassar dengan kecepatan hingga 30+ knot di dalam game! Rasakan pelayaran tradisional suku Mandar dengan simulasi fisika arah angin, manuver pindah haluan (tacking), dan keseimbangan awak di cadik.
            </p>

            <!-- CTA Buttons & Status Badge -->
            <div class="flex flex-wrap items-center gap-3 pt-2">
              {
                isReleased && playStoreUrl ? (
                  <a
                    href={playStoreUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2.5 border border-emerald-500 bg-emerald-600 px-6 py-3.5 font-mono text-xs font-bold text-white transition-all hover:bg-emerald-500 shadow-xl shadow-emerald-950/40"
                  >
                    <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                      <path d="M3.6 1.9c-.3.3-.5.8-.5 1.4v17.4c0 .6.2 1.1.5 1.4l.1.1 9.8-9.8v-.2L3.7 1.8l-.1.1zM17.1 15.7l-3.6-3.6v-.2l3.6-3.6.1.1 4.3 2.5c1.2.7 1.2 1.8 0 2.5l-4.4 2.3zM13.5 12.1L3.7 21.9c.4.4 1 .4 1.6.1l11.8-6.7-3.6-3.2zM13.5 11.9l3.6-3.2L5.3 2c-.6-.3-1.2-.3-1.6.1l9.8 9.8z"/>
                    </svg>
                    Download di Google Play →
                  </a>
                ) : (
                  <div class="inline-flex items-center gap-2.5 border border-amber-400/50 bg-amber-400/15 px-6 py-3.5 font-mono text-xs font-bold text-amber-300">
                    <span class="h-2 w-2 rounded-full bg-amber-400 animate-pulse"></span>
                    Segera Hadir di Google Play
                  </div>
                )
              }
              <a
                href="#gameplay-video"
                class="inline-flex items-center gap-2 border border-accent bg-accent px-6 py-3.5 font-mono text-xs font-bold text-white transition-all hover:bg-orange-500 hover:shadow-xl hover:shadow-orange-900/40"
              >
                <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
                Tonton Cuplikan Gameplay
              </a>
              <a
                href="#etape"
                class="inline-flex items-center gap-2 border border-white/30 bg-white/10 px-5 py-3.5 font-mono text-xs font-medium text-white backdrop-blur-sm transition-all hover:border-white hover:bg-white/20"
              >
                5 Etape Karier ↓
              </a>
              <a
                href="#galeri"
                class="inline-flex items-center gap-2 border border-white/30 bg-white/10 px-5 py-3.5 font-mono text-xs font-medium text-white backdrop-blur-sm transition-all hover:border-white hover:bg-white/20"
              >
                Tangkapan Layar ↓
              </a>
            </div>

            <!-- Hak Cipta DJKI (Tampil otomatis jika diaktifkan) -->
            {
              showDjkiCertificate && (
                <div class="p-3 border border-amber-500/30 bg-amber-500/10 rounded font-mono text-xs text-amber-200 flex items-center gap-2">
                  <span class="text-amber-400 font-bold">✓ HKI DJKI:</span>
                  <span>Tercatat di DJKI Kemenkumham No. {djkiData.nomorPencatatan} ({djkiData.tanggalSertifikat})</span>
                </div>
              )
            }

            <!-- Quick Specs Row -->
            <div class="pt-4 flex flex-wrap gap-4 border-t border-white/15 font-mono text-xs text-slate-300">
              <div><strong class="text-white">Status Rilis:</strong> Segera Hadir di Google Play (2026)</div>
              <div class="text-slate-600">•</div>
              <div><strong class="text-white">Engine:</strong> Godot 4.6.3</div>
              <div class="text-slate-600">•</div>
              <div><strong class="text-white">Kontrol:</strong> Layar Sentuh Slider Ganda</div>
            </div>

          </div>

          <!-- Right Column: Interactive Card Preview -->
          <div class="lg:col-span-5">
            <div class="relative overflow-hidden rounded-xl border border-white/20 bg-[#0c1c27]/95 p-5 shadow-2xl backdrop-blur-md">
              
              <!-- Card Header -->
              <div class="flex items-center justify-between border-b border-white/15 pb-3 font-mono text-xs text-slate-300">
                <span class="flex items-center gap-2 text-amber-400 font-bold">
                  <span class="h-2 w-2 rounded-full bg-amber-400 animate-pulse"></span>
                  RADAR PERLOMBAAN
                </span>
                <span class="text-slate-400">SELAT MAKASSAR</span>
              </div>

              <!-- Animated Poster Graphic -->
              <div class="relative my-4 aspect-[16/10] overflow-hidden rounded-lg border border-white/20 bg-black group">
                <img
                  src="/games/sandeq-rush/screenshots/screenshot-kecepatan-penuh.png"
                  alt="Aksi Balap Sandeq Rush"
                  class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent flex items-end p-4">
                  <div class="font-mono text-xs text-white">
                    <span class="text-amber-400 font-bold">POSISI 1/4 · 30+ KNOT</span>
                    <p class="text-slate-200 text-xs mt-0.5">Memimpin perlombaan di etape Pesisir Majene</p>
                  </div>
                </div>
              </div>

              <!-- Quick Metric Stats -->
              <div class="grid grid-cols-3 gap-2 text-center font-mono text-xs">
                <div class="border border-white/15 bg-white/5 p-2 rounded">
                  <span class="block text-[10px] text-slate-400 uppercase">Kecepatan Game</span>
                  <span class="text-sm font-bold text-amber-400">30+ Knot</span>
                </div>
                <div class="border border-white/15 bg-white/5 p-2 rounded">
                  <span class="block text-[10px] text-slate-400 uppercase">Jalur Etape</span>
                  <span class="text-sm font-bold text-white">5 (5.700 m)</span>
                </div>
                <div class="border border-white/15 bg-white/5 p-2 rounded">
                  <span class="block text-[10px] text-slate-400 uppercase">Ensiklopedia</span>
                  <span class="text-sm font-bold text-emerald-400">12 Entri</span>
                </div>
              </div>

            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- GAMEPLAY TRAILER SECTION -->
    <section id="gameplay-video" class="py-16 sm:py-24 border-b border-rule bg-paper-2">
      <div class="wrap">
        
        <div class="max-w-3xl mb-8">
          <SectionLabel num="01" title="Cuplikan Gameplay" />
          <h2 class="font-serif text-[clamp(2rem,4vw,3.25rem)] font-normal leading-tight text-ink mt-4 mb-3">
            Saksikan Aksi Sandeq Rush dalam Lintasan Nyata
          </h2>
          <p class="text-base text-ink-2 leading-relaxed">
            Rekaman gameplay langsung dari prototipe versi Godot Engine. Tonton bagaimana arah angin dinamis menuntut pemain memindahkan posisi awak kapal dan menyetel sudut layar secara real-time.
          </p>
        </div>

        <!-- Video Player Frame -->
        <div class="relative overflow-hidden border border-rule bg-[#07131b] shadow-2xl rounded-lg">
          
          <!-- Cockpit Header -->
          <div class="flex items-center justify-between border-b border-white/15 bg-[#0f212c] px-4 py-3 font-mono text-xs text-white">
            <div class="flex items-center gap-2">
              <span class="h-2.5 w-2.5 rounded-full bg-red-500"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-amber-500"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
              <span class="ml-2 font-semibold text-white">SANDEQ_RUSH_GAMEPLAY_RAW.MP4</span>
            </div>
            <div class="hidden sm:flex items-center gap-4 text-xs text-slate-300">
              <span>FPS: 60</span>
              <span>RESOLUSI: 1280x720</span>
              <span>AUDIO: STEREO</span>
            </div>
          </div>

          <!-- Video Element (Tanpa teks cadangan mentah yang bocor) -->
          <div class="relative aspect-video w-full bg-black">
            <video
              controls
              preload="metadata"
              poster="/games/sandeq-rush/video/sandeq-rush-hero-poster.jpg"
              class="h-full w-full object-contain"
            >
              <source src="/games/sandeq-rush/video/sandeq-rush-gameplay.mp4" type="video/mp4" />
            </video>
          </div>

          <!-- Video Footer Caption -->
          <div class="border-t border-white/15 bg-[#0f212c] p-4 text-xs font-mono text-slate-300 flex flex-wrap justify-between items-center gap-3">
            <span>Video Gameplay Versi 0.3.1 (Godot Engine &amp; Mekanik Angin)</span>
            <span class="text-amber-400 font-semibold">Pengembang: Alfandhy, S.T. — Polewali Mandar</span>
          </div>

        </div>

      </div>
    </section>

    <!-- MEKANIK & FISIKA ANGIN BERLAYAR -->
    <section class="py-16 sm:py-24 border-b border-rule">
      <div class="wrap">
        
        <div class="max-w-3xl mb-12">
          <SectionLabel num="02" title="Mekanik & Fisika Permainan" />
          <h2 class="font-serif text-[clamp(2rem,4vw,3.25rem)] font-normal leading-tight text-ink mt-4 mb-3">
            Menghidupkan Hukum Fisika Maritim Tradisional
          </h2>
          <p class="text-base text-ink-2 leading-relaxed">
            Perahu Sandeq dirancang dengan lambung ramping hidrodinamis dan layar segitiga yang efisien menangkap angin [SUMBER]. Sandeq Rush menerjemahkan prinsip sains maritim tersebut ke dalam mekanik permainan arcade yang seru dan edukatif.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <div class="border border-rule bg-paper-2 p-6 flex flex-col justify-between">
            <div>
              <span class="font-mono text-xs text-accent font-semibold mb-2 block">01 / SUDUT ANGIN</span>
              <h3 class="font-serif text-xl text-ink font-normal mb-3">Aerodinamika Layar Segitiga</h3>
              <p class="text-sm text-ink-2 leading-relaxed">
