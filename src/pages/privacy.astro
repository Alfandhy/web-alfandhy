---
// Halaman Kebijakan Privasi Umum Situs — alfandhy.my.id
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Link from '../components/Link.astro';
import { SITE } from '../data/site';

const lastUpdated = '11 Oktober 2026';
---

<BaseLayout
  title={`Kebijakan Privasi — ${SITE.name}`}
  description="Kebijakan privasi umum untuk situs web portofolio dan catatan personal alfandhy.my.id."
>
  <main class="py-16 sm:py-24">
    <div class="wrap max-w-3xl">
      <SectionLabel number="00" title="Informasi Legal" />

      <h1 class="font-serif text-[clamp(2.5rem,6vw,4.5rem)] font-normal leading-[1.08] tracking-[-0.02em] text-ink mt-8 mb-4">
        Kebijakan Privasi
      </h1>
      <p class="font-mono text-xs text-ink-2 mb-12">Pembaruan terakhir: {lastUpdated}</p>

      <div class="space-y-10 text-base leading-relaxed text-ink/90 font-sans">
        <section class="border-t border-rule pt-6">
          <h2 class="font-serif text-2xl text-ink mb-3 font-normal">1. Ruang Lingkup</h2>
          <p class="text-ink-2">
            Kebijakan privasi ini berlaku secara eksklusif untuk situs web portofolio personal <strong>alfandhy.my.id</strong>. 
            Situs ini dibuat untuk menampilkan karya desain, eksplorasi AI, materi edukasi, dan proyek kreatif milik Alfandhy.
          </p>
        </section>

        <section class="border-t border-rule pt-6">
          <h2 class="font-serif text-2xl text-ink mb-3 font-normal">2. Data Pengunjung & Analitik</h2>
          <p class="text-ink-2">
            Situs ini tidak mengharuskan pendaftaran akun dan tidak mengumpulkan informasi identitas pribadi (seperti nama atau alamat) secara rahasia. 
            Kami hanya dapat memproses data teknis anonim standar web (seperti tipe peramban, resolusi layar, dan halaman yang dikunjungi) semata-mata untuk mengoptimalkan performa dan keterbacaan situs.
          </p>
        </section>

        <section class="border-t border-rule pt-6">
          <h2 class="font-serif text-2xl text-ink mb-3 font-normal">3. Kebijakan Privasi Aplikasi & Game</h2>
          <p class="text-ink-2">
            Produk digital terpisah seperti game (termasuk <strong>Sandeq Rush</strong>) memiliki kebijakan privasi dan pemrosesan data mandiri yang diatur khusus sesuai ketentuan platform distribusi (seperti Google Play Store). 
            Tautan kebijakan privasi spesifik untuk game tersebut dapat diakses langsung melalui laman masing-masing game di situs ini.
          </p>
        </section>

        <section class="border-t border-rule pt-6">
          <h2 class="font-serif text-2xl text-ink mb-3 font-normal">4. Komunikasi Langsung</h2>
          <p class="text-ink-2">
            Jika Anda menghubungi kami melalui email atau tautan media sosial yang tertera pada situs, informasi kontak yang Anda kirimkan hanya akan digunakan untuk membalas komunikasi atau membicarakan kolaborasi profesional. Kami tidak akan membagikan atau menjual data kontak Anda ke pihak ketiga mana pun.
          </p>
        </section>

        <section class="border-t border-rule pt-6">
          <h2 class="font-serif text-2xl text-ink mb-3 font-normal">5. Pertanyaan & Kontak</h2>
          <p class="text-ink-2">
            Jika Anda memiliki pertanyaan terkait privasi pada situs ini, Anda dapat mengirimkan surat elektronik ke:
          </p>
          <p class="mt-3">
            <Link href="mailto:halo@alfandhy.my.id" class="text-ink font-mono text-sm underline">halo@alfandhy.my.id</Link>
          </p>
        </section>
      </div>

      <div class="mt-16 border-t border-rule pt-8">
        <Link href="/" class="text-sm font-mono text-ink">← Kembali ke Beranda</Link>
      </div>
    </div>
  </main>
</BaseLayout>
